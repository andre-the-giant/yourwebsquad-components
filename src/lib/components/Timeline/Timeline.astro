---
/*
Timeline — dated milestones: company history, project log, renovation diary.
For numbered "how it works" steps use Steps (layout="timeline") instead.
Props:
- items: { date: string, datetime?: string, title: string, text?: string,
    image?: { src: string, alt?: string } }[]
  date: what readers see ("Spring 2019"); datetime: machine value ("2019-04").
- heading?: string
- layout?: "single" | "alternate" — alternate puts items left and right of a centre
  line on large screens; phones always get a single column (default "single")
- tone?: "default" | "surface"
- id?: string
- class?: string
- style?: string
Accessibility: an ordered list in reading order, each date in <time> when datetime is set;
the line and dots are decorative. Alternate layout only moves boxes, never the order.
Theme variables: --timeline-line (colour), --timeline-line-width, --timeline-line-bg
(any background: stripes, dots), --timeline-dot, --timeline-dot-size, --timeline-dot-top,
--timeline-date-color, --timeline-date-font, --timeline-date-size, --timeline-date-bg,
--timeline-date-padding, --timeline-date-transform, --timeline-date-tracking,
--timeline-card-bg, --timeline-card-border, --timeline-card-padding, --timeline-card-shadow.
Shared style knobs: --marker-*, --media-frame (see tokens.css §4).
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  items: z
    .array(
      z.looseObject({
        date: z.string(),
        datetime: z.string().optional(),
        title: z.string(),
        text: z.string().optional(),
        image: z.looseObject({ src: z.string(), alt: z.string().default("") }).optional()
      })
    )
    .min(1),
  heading: z.string().optional(),
  layout: z.enum(["single", "alternate"]).default("single"),
  tone: z.enum(["default", "surface"]).default("default")
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  items,
  heading,
  layout,
  tone,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Timeline" });

const headingId = heading ? nextId("timeline") : undefined;
---

<section
  id={id}
  class={mergeClasses("timeline", `timeline--${layout}`, `timeline--${tone}`, className)}
  style={style}
  aria-labelledby={headingId}
  {...rest}
>
  {
    heading && (
      <h2 id={headingId} class="timeline__heading">
        {heading}
      </h2>
    )
  }
  <ol class="timeline__list">
    {
      items.map((item) => (
        <li class="timeline__item">
          <span class="timeline__dot" aria-hidden="true" />
          <div class="timeline__card">
            {item.datetime ? (
              <time class="timeline__date" datetime={item.datetime}>
                {item.date}
              </time>
            ) : (
              <span class="timeline__date">{item.date}</span>
            )}
            <h3 class="timeline__title">{item.title}</h3>
            {item.text && <p class="timeline__text">{item.text}</p>}
            {item.image && (
              <img
                class="timeline__image"
                src={item.image.src}
                alt={item.image.alt}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    --_dot: var(--timeline-dot-size, 0.875rem);
    --_gutter: 2rem;
    --_line: var(--timeline-line-width, 2px);
    padding-block: var(--space-6);
  }

  .timeline--surface {
    background: var(--color-surface);
    padding-inline: var(--space-4);
  }

  .timeline__heading {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--size-xl);
    line-height: var(--line-tight);
  }

  .timeline__list {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The line. */
  .timeline__list::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem;
    inset-inline-start: calc(var(--_dot) / 2 - var(--_line) / 2);
    width: var(--_line);
    background: var(--timeline-line-bg, var(--timeline-line, var(--color-border)));
  }

  .timeline__item {
    position: relative;
    padding-inline-start: var(--_gutter);
  }

  .timeline__dot {
    position: absolute;
    top: var(--timeline-dot-top, 0.35rem);
    inset-inline-start: 0;
    box-sizing: border-box;
    width: var(--_dot);
    height: var(--_dot);
    border: var(--marker-border, 0);
    border-radius: var(--marker-radius, 50%);
    background: var(--timeline-dot, var(--marker-bg, var(--color-fg)));
    box-shadow: 0 0 0 4px var(--color-bg);
    rotate: var(--marker-rotate, 0deg);
  }

  .timeline--surface .timeline__dot {
    box-shadow: 0 0 0 4px var(--color-surface);
  }

  .timeline__card {
    display: grid;
    gap: var(--space-1);
    max-width: 38rem;
    padding: var(--timeline-card-padding, 0);
    border: var(--timeline-card-border, 0);
    background: var(--timeline-card-bg, transparent);
    box-shadow: var(--timeline-card-shadow, none);
  }

  .timeline__date {
    justify-self: start;
    padding: var(--timeline-date-padding, 0);
    background: var(--timeline-date-bg, transparent);
    color: var(--timeline-date-color, var(--color-fg-muted, inherit));
    font-family: var(--timeline-date-font, inherit);
    font-size: var(--timeline-date-size, var(--size-sm));
    font-weight: var(--weight-semibold);
    letter-spacing: var(--timeline-date-tracking, normal);
    text-transform: var(--timeline-date-transform, none);
    font-variant-numeric: tabular-nums;
  }

  .timeline__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-lg);
    line-height: var(--line-tight);
  }

  .timeline__text {
    margin: 0;
    line-height: var(--line-normal);
  }

  .timeline__image {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-2);
    border-radius: var(--radius-md);
    outline: var(--media-frame, none);
    outline-offset: var(--media-frame-offset, 0);
  }

  @media (min-width: 48rem) {
    .timeline--alternate .timeline__list::before {
      inset-inline-start: calc(50% - var(--_line) / 2);
    }

    .timeline--alternate .timeline__item {
      width: 50%;
      padding-inline: 0 var(--_gutter);
      text-align: end;
    }

    .timeline--alternate .timeline__item:nth-child(even) {
      margin-inline-start: 50%;
      padding-inline: var(--_gutter) 0;
      text-align: start;
    }

    .timeline--alternate .timeline__dot {
      inset-inline-start: auto;
      inset-inline-end: calc(var(--_dot) / -2);
    }

    .timeline--alternate .timeline__item:nth-child(even) .timeline__dot {
      inset-inline-start: calc(var(--_dot) / -2);
      inset-inline-end: auto;
    }

    .timeline--alternate .timeline__card {
      margin-inline-start: auto;
    }

    .timeline--alternate .timeline__item:nth-child(odd) .timeline__date {
      justify-self: end;
    }

    .timeline--alternate .timeline__item:nth-child(even) .timeline__card {
      margin-inline-start: 0;
    }
  }
</style>
