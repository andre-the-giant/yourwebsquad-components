---
/*
CtaBand — one action, with a large title. Use it once per page, usually last.
Props:
- heading: string
- text?: string
- action: { label: string, href?: string }
- tone?: "accent" | "inverse" — ignored when `shader` is set
- shader?: "waves" | "smoke-ring" | "god-rays" | "neuro-noise" — animated WebGL background (see ShaderBackground); text turns light
- shaderColors?: string[] — 2 to 8 hex colours, low → high; the first is the dark base
- animate?: boolean — shader motion, default true (still frame under prefers-reduced-motion)
- id?: string
- class?: string
- style?: string
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { mergeClasses } from "../../utils/style.js";
import Band from "../Band/Band.astro";
import Button from "../Button/Button.astro";
import ShaderBackground from "../ShaderBackground/ShaderBackground.astro";
import { shaderNames, shaderPalette, HEX_COLOR } from "../ShaderBackground/presets/index.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  heading: z.string(),
  text: z.string().optional(),
  action: z.looseObject({ label: z.string(), href: z.string().optional() }),
  tone: z.enum(["accent", "inverse"]).default("accent"),
  shader: z.enum(shaderNames).optional(),
  shaderColors: z.array(z.string().regex(HEX_COLOR)).min(2).max(8).optional(),
  animate: z.boolean().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  heading,
  text,
  action,
  tone,
  shader,
  shaderColors,
  animate
} = parseProps(Schema, Astro.props, { component: "CtaBand" });

const headingId = nextId("ctaband");
const shaderBase = shader ? `--_shader-base: ${shaderPalette(shader, shaderColors).ink}` : null;
const resolvedStyle = [shaderBase, style].filter(Boolean).join("; ") || undefined;
---

<Band
  id={id}
  class={mergeClasses("ctaband", shader && "ctaband--shader", className)}
  style={resolvedStyle}
  tone={shader ? "default" : tone}
  labelledby={headingId}
>
  {
    shader && (
      <ShaderBackground
        shader={shader}
        colors={shaderColors}
        animate={animate ?? true}
        scrim="start"
      />
    )
  }
  <div class="ctaband__grid">
    <h2 id={headingId} class="ctaband__title">{heading}</h2>
    <div class="ctaband__side">
      {text && <p class="ctaband__text">{text}</p>}
      <Button label={action.label} href={action.href} size="lg" />
    </div>
  </div>
</Band>

<style>
  /* Band's root is rendered by Band, hence :global on it. The shader sits behind the
     content, and text and outline buttons turn white on its dark base. */
  :global(.ctaband.ctaband--shader) {
    --color-fg: rgb(255, 255, 255);
    --color-fg-rgb: 255, 255, 255;
    --button-outline-fg: rgb(255, 255, 255);
    --button-outline-border: rgb(255, 255, 255);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Solid base under the canvas: shows before WebGL starts and gives checkers a background */
    background-color: var(--_shader-base);
    color: rgb(255, 255, 255);
  }

  .ctaband__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .ctaband__title {
    margin: 0;
    font-family: var(--font-display);
    text-transform: var(--type-heading-transform, none);
    font-size: clamp(2.375rem, 6.4vw, 5.5rem);
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: 0.98;
    letter-spacing: var(--type-h1-tracking, normal);
    overflow-wrap: break-word;
  }

  .ctaband__side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    justify-items: start;
  }

  /* Bold at this size so that it counts as large text on a saturated background */
  .ctaband__text {
    max-width: 44ch;
    margin: 0;
    font-size: 1.1875rem;
    font-weight: var(--weight-bold);
    line-height: 1.4;
  }

  @media (min-width: 56.25rem) {
    .ctaband__grid {
      grid-template-columns: 8fr 4fr;
      gap: 3rem;
      align-items: end;
    }
  }
</style>
