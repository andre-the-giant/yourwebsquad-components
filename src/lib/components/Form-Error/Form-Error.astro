---
/*
Form-Error — inline field error text. Pairs with `errorId` passed to a form
field for aria-describedby. Props are validated with zod (see Schema).
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  text: z.string().optional(),
  role: z.string().optional(),
  ariaLive: z.enum(["polite", "assertive", "off"]).default("polite")
});

type Props = z.input<typeof Schema>;

const {
  id,
  text,
  class: className,
  style,
  role,
  ariaLive,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Form-Error" });

const resolvedId = id ?? nextId("form-error");
const resolvedStyle = makeStyleVars({}, style);
const resolvedClass = mergeClasses("form-error", className);
---

<p
  id={resolvedId}
  class={resolvedClass}
  role={role}
  aria-live={role ? undefined : ariaLive}
  aria-atomic={role ? undefined : "true"}
  style={resolvedStyle || undefined}
  {...rest}
>
  <slot>{text}</slot>
  {Astro.slots.has("suffix") ? <slot name="suffix" /> : null}
</p>

<style>
  .form-error {
    color: var(--form-error-color);
    font-size: var(--size-sm);
    margin: 0;
    line-height: var(--line-normal);
  }
</style>
