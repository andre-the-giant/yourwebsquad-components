---
/*
Form-Hidden — hidden input. Props are validated with zod (see Schema).
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  name: z.string().optional(),
  value: z.union([z.string(), z.number()]).optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  name,
  value,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Form-Hidden" });

const resolvedId = id ?? nextId("form-hidden");
const resolvedValue = value ?? "";
const resolvedStyle = makeStyleVars({}, style);
const resolvedClass = mergeClasses(className);
---

<input
  type="hidden"
  id={resolvedId}
  name={name}
  value={resolvedValue}
  class={resolvedClass || undefined}
  style={resolvedStyle || undefined}
  {...rest}
/>
