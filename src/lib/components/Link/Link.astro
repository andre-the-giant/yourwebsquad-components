---
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars } from "../../utils/style.js";
import Icon from "../Icon/Icon.astro";
import Button from "../Button/Button.astro";
/*
Props:
- label?: string
- href?: string
- target?: string
- rel?: string
- variant?: "solid" | "outline" | "ghost" (default "ghost")
- size?: "xs" | "sm" | "md" | "lg" (default "md")
- disabled?: boolean
- id?: string
- class?: string
- style?: string
- screenreader?: string
Notes:
- rel defaults to "noreferrer" when target is "_blank".
*/
const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  label: z.string().optional(),
  href: z.string().optional(),
  target: z.string().optional(),
  rel: z.string().optional(),
  variant: z.string().optional(),
  size: z.string().optional(),
  disabled: z.boolean().optional(),
  screenreader: z.string().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  label = "Read more",
  href,
  target,
  rel,
  variant = "ghost",
  size = "md",
  disabled = false,
  screenreader,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Link" });
const resolvedId = id ?? nextId("link");
const resolvedLabel = label;
const resolvedHref = href;
const resolvedTarget = target;
const resolvedRel = rel ?? (resolvedTarget === "_blank" ? "noreferrer" : undefined);
const isExternal = resolvedHref && /^(https?:)?\/\//.test(resolvedHref);
const resolvedStyle = makeStyleVars({}, style);
const accessibleLabel = screenreader ?? resolvedLabel;
---

<Button
  id={resolvedId}
  class={className}
  href={resolvedHref}
  target={resolvedTarget}
  rel={resolvedRel}
  disabled={disabled}
  variant={variant}
  size={size}
  screenreader={screenreader}
  style={resolvedStyle || undefined}
  {...rest}
>
  <span><slot>{resolvedLabel}</slot></span>
  {
    isExternal && (
      <Icon
        name="external"
        size={size === "sm" ? "sm" : "md"}
        label={accessibleLabel ? `${accessibleLabel} (opens in new tab)` : undefined}
      />
    )
  }
</Button>
