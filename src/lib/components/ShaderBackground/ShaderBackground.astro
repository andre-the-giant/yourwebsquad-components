---
/*
ShaderBackground — animated WebGL background (21st.dev Shader Builder presets) that fills
its parent. The parent needs `position: relative` and `isolation: isolate`; Hero, PageHero
and CtaBand do this for you through their `shader` prop.
Props:
- shader?: "waves" | "smoke-ring" | "god-rays" | "neuro-noise" — preset name (see presets/index.js).
    waves: 21st.dev Shader Builder (WebGL1). The others: Paper Shaders, Apache-2.0 (WebGL2).
- colors?: string[] — 2 to 8 hex colours; the first is the dark base text sits on.
    waves: low → high. smoke-ring: background, ring colours. god-rays: background, bloom, rays.
    neuro-noise: background, lines, highlights. #rrggbbaa sets opacity (Paper presets).
- animate?: boolean — default true. false, or prefers-reduced-motion, draws one still frame
- scrim?: "even" | "start" | "corner" | "none" — dark overlay so text stays readable
    even: the whole area, start: from the inline start edge, corner: from the bottom-left corner
- flip?: boolean — turn the pattern upside down (puts the palette's dark end at the top)
- id?: string
- class?: string
- style?: string
Style variables:
- --shader-scrim: replaces the overlay (any background value)
- --shader-scrim-opacity: strength of the "even" overlay, default 0.6
Without WebGL a CSS gradient of the same colours shows instead.
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";
import {
  shaderNames,
  shaderPresets,
  shaderPalette,
  hexToRgbTriplet,
  HEX_COLOR
} from "./presets/index.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  shader: z.enum(shaderNames).optional(),
  colors: z.array(z.string().regex(HEX_COLOR)).min(2).max(8).optional(),
  animate: z.boolean().optional(),
  scrim: z.enum(["even", "start", "corner", "none"]).optional(),
  flip: z.boolean().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  shader,
  colors,
  animate,
  scrim,
  flip,
  ...rest
} = parseProps(Schema, Astro.props, { component: "ShaderBackground" });

const resolvedShader = shader ?? "waves";
const palette = shaderPalette(resolvedShader, colors);
const resolvedScrim = scrim ?? "even";
const isPaper = "engine" in shaderPresets[resolvedShader];
const gradientDirection =
  (palette.darkEdge === "bottom") !== Boolean(flip) ? "to top" : "to bottom";

const resolvedStyle = makeStyleVars(
  {
    "--shader-ink": hexToRgbTriplet(palette.ink),
    "--shader-fallback": `linear-gradient(${gradientDirection}, ${palette.colors.join(", ")})`
  },
  style
);
const resolvedClass = mergeClasses(
  "shader-bg",
  `shader-bg--scrim-${resolvedScrim}`,
  flip && "shader-bg--flip",
  className
);
---

<div id={id} class={resolvedClass} style={resolvedStyle || undefined} aria-hidden="true" {...rest}>
  {
    isPaper ? (
      <div
        class="shader-bg__canvas"
        data-shader={resolvedShader}
        data-colors={JSON.stringify(palette.colors)}
        data-animate={String(animate ?? true)}
      />
    ) : (
      <canvas
        class="shader-bg__canvas"
        data-shader={resolvedShader}
        data-colors={JSON.stringify(palette.colors)}
        data-animate={String(animate ?? true)}
      />
    )
  }
</div>

<style>
  .shader-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: rgb(var(--shader-ink));
  }
  .shader-bg__canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: var(--shader-fallback);
  }
  .shader-bg--flip .shader-bg__canvas {
    transform: scaleY(-1);
  }
  .shader-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--shader-scrim, var(--_scrim, none));
  }
  .shader-bg--scrim-even {
    --_scrim: rgb(var(--shader-ink) / var(--shader-scrim-opacity, 0.6));
  }
  .shader-bg--scrim-start {
    --_scrim: linear-gradient(
      to right,
      rgb(var(--shader-ink) / 0.85),
      rgb(var(--shader-ink) / 0.5) 55%,
      rgb(var(--shader-ink) / 0.2)
    );
  }
  .shader-bg--scrim-corner {
    --_scrim: linear-gradient(
      to top right,
      rgb(var(--shader-ink) / 0.85),
      rgb(var(--shader-ink) / 0.45) 50%,
      transparent 85%
    );
  }
  :global([dir="rtl"]) .shader-bg--scrim-start {
    --_scrim: linear-gradient(
      to left,
      rgb(var(--shader-ink) / 0.85),
      rgb(var(--shader-ink) / 0.5) 55%,
      rgb(var(--shader-ink) / 0.2)
    );
  }
</style>

<script>
  import { mountShader } from "./engine.js";
  import { mountPaper } from "./paper-engine.js";
  import { shaderPresets } from "./presets/index.js";

  // One WebGL context per shader. Under reduced motion or animate={false} it draws a
  // single still frame. Both engines pause while the tab is hidden or the shader is
  // off screen.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>(".shader-bg__canvas[data-shader]").forEach((el) => {
    if (el.dataset.mounted !== undefined) return;
    el.dataset.mounted = "";
    const preset = shaderPresets[el.dataset.shader as keyof typeof shaderPresets];
    if (!preset) return;
    let colors: string[] = [];
    try {
      colors = JSON.parse(el.dataset.colors ?? "[]");
    } catch {
      colors = [];
    }
    const options = {
      colors,
      animate: el.dataset.animate !== "false" && !reduceMotion.matches
    };
    if ("engine" in preset) mountPaper(el, preset, options);
    else if (el instanceof HTMLCanvasElement) mountShader(el, preset, options);
  });
</script>
