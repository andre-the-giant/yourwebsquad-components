---
/*
Form-Help — inline field help text. Pairs with `helpId` passed to a form field
for aria-describedby. Props are validated with zod (see Schema).
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  text: z.string().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  text,
  class: className,
  style,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Form-Help" });

const resolvedId = id ?? nextId("form-help");
const resolvedStyle = makeStyleVars({}, style);
const resolvedClass = mergeClasses("form-help", className);
---

<p id={resolvedId} class={resolvedClass} style={resolvedStyle || undefined} {...rest}>
  <slot>{text}</slot>
  {Astro.slots.has("suffix") ? <slot name="suffix" /> : null}
</p>

<style>
  .form-help {
    color: var(--form-help-color);
    font-size: var(--size-sm);
    margin: 0;
    line-height: var(--line-normal);
  }
</style>
