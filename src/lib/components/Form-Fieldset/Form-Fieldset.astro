---
/*
Props:
- id?: string
- legend?: string
- description?: string
- helpId?: string
- errorId?: string
- required?: boolean
- class?: string
- style?: string
Notes:
- Wraps grouped fields (e.g., radio/checkbox sets) with semantic fieldset/legend.
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  legend: z.string().optional(),
  description: z.string().optional(),
  helpId: z.string().optional(),
  errorId: z.string().optional(),
  required: z.boolean().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  legend,
  description,
  helpId,
  errorId,
  required = false,
  class: className,
  style,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Form-Fieldset" });

const resolvedLegend = legend;
const resolvedDescription = description;
const resolvedId = id ?? nextId("form-fieldset");
const describedIds = [helpId, errorId].filter(Boolean).join(" ");
const styleVars = {};
const resolvedStyle = makeStyleVars(styleVars, style);
const resolvedClass = mergeClasses("form-fieldset", className);
---

<fieldset
  id={resolvedId}
  class={resolvedClass}
  aria-describedby={describedIds || undefined}
  style={resolvedStyle || undefined}
  {...rest}
>
  {
    resolvedLegend ? (
      <legend class="form-fieldset__legend">
        {resolvedLegend}
        {required ? <span class="required">*</span> : null}
      </legend>
    ) : null
  }

  {resolvedDescription ? <p class="form-fieldset__description">{resolvedDescription}</p> : null}

  <div class="form-fieldset__body">
    <slot />
  </div>

  <slot name="help" />
  <slot name="error" />
</fieldset>

<style>
  .form-fieldset {
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-2);
  }

  .form-fieldset__legend {
    font-weight: var(--weight-medium);
    padding: 0 var(--space-1);
  }

  .form-fieldset__description {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--size-sm);
  }

  .form-fieldset__body {
    display: grid;
    gap: var(--space-2);
  }

  .required {
    color: var(--form-error-color);
    margin-left: 0.25rem;
  }
</style>
