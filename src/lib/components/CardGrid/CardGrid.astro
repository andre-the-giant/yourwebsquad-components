---
/*
CardGrid — comparable items, with or without a link. The whole card is clickable
through the single link in its title.
Props:
- heading?: string
- intro?: string
- items: { title: string, text?: string, href?: string,
           img?: string, alt?: string, tag?: string, meta?: string, tags?: string[] }[]
  An item with img becomes a photo card: photo, tag, title, text, meta line.
  tags are written to data-tags so a FilterBar can filter the grid.
- columns?: 2 | 3
- compact?: boolean — photo cards with a square photo on the left
- ratio?: string — photo ratio of photo cards (default "4/3")
- initial?: number — show this many cards, then a "Show more" button that adds as many
- moreLabel?: string — label of that button
- countLabel?: string — "{shown} of {total} shown"
- filled?: boolean — filled cards instead of a top rule
- actions?: { label: string, href?: string, variant?: "solid"|"outline"|"ghost" }[]
- tone?: "default" | "surface" | "inverse"
- flush?: boolean
- id?: string
- class?: string
- style?: string
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { mergeClasses } from "../../utils/style.js";
import Band from "../Band/Band.astro";
import Button from "../Button/Button.astro";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  heading: z.string().optional(),
  intro: z.string().optional(),
  items: z
    .array(
      z.looseObject({
        title: z.string(),
        text: z.string().optional(),
        href: z.string().optional(),
        img: z.string().optional(),
        alt: z.string().optional(),
        tag: z.string().optional(),
        meta: z.string().optional(),
        tags: z.array(z.string()).optional()
      })
    )
    .default([]),
  compact: z.boolean().default(false),
  ratio: z.string().default("4/3"),
  initial: z.number().int().positive().optional(),
  moreLabel: z.string().default("Show more"),
  countLabel: z.string().default("{shown} of {total} shown"),
  columns: z.union([z.literal(2), z.literal(3)]).default(3),
  filled: z.boolean().default(false),
  actions: z
    .array(
      z.looseObject({
        label: z.string(),
        href: z.string().optional(),
        variant: z.enum(["solid", "outline", "ghost"]).optional()
      })
    )
    .default([]),
  tone: z.enum(["default", "surface", "inverse"]).default("default"),
  flush: z.boolean().default(false)
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  heading,
  intro,
  items,
  columns,
  filled,
  actions,
  tone,
  flush,
  compact,
  ratio,
  initial,
  moreLabel,
  countLabel
} = parseProps(Schema, Astro.props, { component: "CardGrid" });

const headingId = nextId("cardgrid");
const listId = nextId("cardgrid-list");
const hasMore = typeof initial === "number" && items.length > initial;
---

<Band
  id={id}
  class={mergeClasses("cardgrid", className)}
  style={style}
  tone={tone}
  flush={flush}
  labelledby={heading ? headingId : undefined}
>
  {
    heading && (
      <h2 id={headingId} class="cardgrid__title">
        {heading}
      </h2>
    )
  }
  {intro && <p class="cardgrid__intro">{intro}</p>}
  <ul
    id={listId}
    class:list={[
      "cardgrid__list",
      `cardgrid__list--${columns}`,
      (filled || items.some((item) => item.img)) && "is-filled",
      compact && "is-compact"
    ]}
    style={`--card-ratio: ${ratio}`}
    data-cardgrid-initial={hasMore ? String(initial) : undefined}
  >
    {
      items.map((item) => (
        <li
          class:list={[
            "card",
            item.href && "card--link",
            filled && !item.img && "card--filled",
            item.img && "card--photo"
          ]}
          data-tags={item.tags?.length ? item.tags.join(" ") : undefined}
          tabindex={hasMore ? "-1" : undefined}
        >
          {item.img && (
            <div class="card__media">
              <img src={item.img} alt={item.alt ?? ""} loading="lazy" decoding="async" />
            </div>
          )}
          <div class="card__body">
          {item.tag && <p class="card__tag">{item.tag}</p>}
          <h3 class="card__title">
            {item.href ? <a href={item.href}>{item.title}</a> : item.title}
          </h3>
          {item.text && <p class="card__text">{item.text}</p>}
          {item.meta && <p class="card__meta">{item.meta}</p>}
          {item.href && !item.img && (
            <svg
              class="card__arrow"
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M3 10h13M11 5l5 5-5 5" />
            </svg>
          )}
          </div>
        </li>
      ))
    }
  </ul>
  {
    hasMore && (
      <div class="cardgrid__more" data-cardgrid-more={listId} hidden>
        <Button label={moreLabel} variant="outline" class="cardgrid__more-button" />
        <p class="cardgrid__count" aria-live="polite" data-count-label={countLabel} />
      </div>
    )
  }
  {
    actions.length > 0 && (
      <div class="cardgrid__actions">
        {actions.map((b) => (
          <Button label={b.label} href={b.href} variant={b.variant ?? "outline"} />
        ))}
      </div>
    )
  }
</Band>

<script>
  // "Show more": the cards are all in the HTML (readable without JS); the script hides
  // the extra ones, then reveals them in batches and moves the focus to the first new card.
  for (const more of document.querySelectorAll<HTMLElement>("[data-cardgrid-more]")) {
    const list = document.getElementById(more.dataset.cardgridMore ?? "");
    if (!list) continue;
    const step = Number(list.dataset.cardgridInitial);
    const cards = [...list.children] as HTMLElement[];
    const button = more.querySelector("button");
    const count = more.querySelector<HTMLElement>(".cardgrid__count");
    const template = count?.dataset.countLabel ?? "{shown} of {total} shown";
    let shown = step;
    const render = () => {
      cards.forEach((card, index) => (card.hidden = index >= shown));
      if (count) {
        count.textContent = template
          .replace("{shown}", String(Math.min(shown, cards.length)))
          .replace("{total}", String(cards.length));
      }
      more.hidden = false;
      if (button) button.hidden = shown >= cards.length;
    };
    button?.addEventListener("click", () => {
      const firstNew = shown;
      shown += step;
      render();
      cards[firstNew]?.focus();
    });
    render();
  }
</script>

<style>
  .cardgrid__title {
    max-width: 22ch;
    margin: 0 0 clamp(1.75rem, 4vw, 3.5rem);
    font-family: var(--font-display);
    font-size: var(--type-h2, clamp(2rem, 4vw, 3rem));
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: var(--type-h2-line, 1.1);
    letter-spacing: var(--type-h2-tracking, normal);
  }

  .cardgrid__intro {
    max-width: 52ch;
    margin: calc(clamp(1.75rem, 4vw, 3.5rem) * -0.5) 0 clamp(1.75rem, 4vw, 3rem);
    font-size: var(--type-lead, clamp(1.25rem, 2.1vw, 1.6875rem));
    line-height: 1.35;
  }

  .cardgrid__list {
    display: grid;
    gap: 0 clamp(1.25rem, 2.6vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cardgrid__list.is-filled {
    gap: clamp(1.25rem, 2.6vw, 2rem);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.125rem 0 clamp(1.75rem, 3vw, 2.5rem);
    border-top: 2px solid currentColor;
    transition: box-shadow 150ms ease-out;
  }

  .card--filled {
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    border-top: 0;
    background: var(--band-surface-bg, var(--color-surface));
  }

  .card--link:hover {
    box-shadow: inset 0 3px 0 var(--color-accent);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h3, clamp(1.5rem, 2.6vw, 2.125rem));
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: var(--type-h3-line, 1.15);
    letter-spacing: var(--type-h3-tracking, normal);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__title a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .card__text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card[hidden] {
    display: none;
  }

  .card:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Photo card */
  .card--photo {
    gap: 1.125rem;
    padding: 0;
    border-top: 0;
  }

  .card__media {
    aspect-ratio: var(--card-ratio, 4/3);
    overflow: hidden;
    background: var(--color-surface);
  }

  .card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card--photo.card--link:hover {
    box-shadow: none;
  }

  .card--photo.card--link:hover .card__media img {
    transform: scale(1.04);
  }

  .card--photo.card--link:hover .card__title {
    color: var(--color-accent);
  }

  .card__tag {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold, 600);
    color: var(--color-accent);
  }

  .card__meta {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Compact: square photo on the left */
  .is-compact .card--photo {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--color-border);
    background: var(--band-surface-bg, var(--color-bg));
  }

  .is-compact .card__media {
    flex: 0 0 6.5rem;
    aspect-ratio: 1;
  }

  .is-compact .card__body {
    padding-inline-end: 1rem;
  }

  .is-compact .card__title {
    font-size: 1.25rem;
  }

  .cardgrid__more {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }

  .cardgrid__more[hidden] {
    display: none;
  }

  .cardgrid__more :global(button[hidden]) {
    display: none;
  }

  .cardgrid__count {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .card__arrow {
    margin-block-start: auto;
    padding-block-start: 0.375rem;
    box-sizing: content-box;
  }

  .cardgrid__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-block-start: 1.5rem;
  }

  @media (min-width: 40rem) {
    .cardgrid__list--2,
    .cardgrid__list--3 {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 56.25rem) {
    .cardgrid__list--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__media img {
      transition: none;
    }

    .card--photo.card--link:hover .card__media img {
      transform: none;
    }
  }
</style>
