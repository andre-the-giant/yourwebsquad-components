---
/*
Button — renders an <a> when `href` is set, otherwise a <button>.
Props are validated with zod (see Schema). `rel` defaults to "noreferrer"
when `target` is "_blank".
Theme variables (all optional, neutral defaults):
- --button-skew: slants the button (such as -8deg); the label is straightened back
- --button-text-transform, --button-letter-spacing: label case and tracking
- --button-border-width: default 1px
- --button-min-height: default auto
- --button-solid-hover-bg, --button-solid-hover-fg, --button-solid-hover-border
- --button-solid-hover-shadow: shadow of the solid button on hover
- --button-solid-hover-lift: vertical move on hover, default -1px
- --button-solid-active-shadow: shadow while pressed
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { makeStyleVars, mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  label: z.string().default("Button"),
  href: z.string().optional(),
  target: z.string().optional(),
  rel: z.string().optional(),
  variant: z.enum(["solid", "outline", "ghost"]).default("solid"),
  size: z.enum(["xs", "sm", "md", "lg"]).default("md"),
  type: z.enum(["button", "submit", "reset"]).default("button"),
  disabled: z.boolean().default(false),
  screenreader: z.string().optional()
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  label,
  href,
  target,
  rel,
  variant,
  size,
  type,
  disabled,
  screenreader,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Button" });

const resolvedId = id ?? nextId("button");
const resolvedHref = href;
const resolvedTarget = target;
const resolvedRel = rel ?? (resolvedTarget === "_blank" ? "noreferrer" : undefined);
const resolvedStyle = makeStyleVars({}, style);
const resolvedClass = mergeClasses("button", `button--${variant}`, `button--${size}`, className);
---

{
  resolvedHref ? (
    <a
      id={resolvedId}
      class={resolvedClass}
      href={disabled ? undefined : resolvedHref}
      target={resolvedTarget}
      rel={resolvedRel}
      role={disabled ? "link" : undefined}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? "-1" : undefined}
      style={resolvedStyle || undefined}
      {...rest}
    >
      <span class="button__label">
        <slot>{label}</slot>
      </span>
      {screenreader && <span class="sr-only">{screenreader}</span>}
    </a>
  ) : (
    <button
      id={resolvedId}
      class={resolvedClass}
      type={type}
      disabled={disabled}
      style={resolvedStyle || undefined}
      {...rest}
    >
      <span class="button__label">
        <slot>{label}</slot>
      </span>
      {screenreader && <span class="sr-only">{screenreader}</span>}
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    place-content: center;
    gap: var(--space-2);
    padding: 0.65rem 1.5rem;
    min-height: var(--button-min-height, auto);
    border-radius: 0;
    border: var(--button-border-width, 1px) solid transparent;
    font-family: var(--button-font, var(--font-body));
    font-weight: var(--weight-semibold);
    font-size: var(--size-md);
    line-height: var(--line-tight);
    letter-spacing: var(--button-letter-spacing, normal);
    text-transform: var(--button-text-transform, none);
    text-decoration: none;
    cursor: pointer;
    transform: skewX(var(--button-skew, 0deg));
    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      background 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }

  /* The label stays upright when the theme slants the button */
  .button__label {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    transform: skewX(calc(var(--button-skew, 0deg) * -1));
  }

  .button:focus-visible {
    outline: 2px solid var(--button-focus);
    outline-offset: 2px;
  }

  .button[aria-disabled="true"],
  .button:disabled {
    opacity: var(--button-disabled-opacity);
    cursor: not-allowed;
  }

  .button--solid {
    background: var(--button-solid-bg);
    color: var(--button-solid-fg);
    border-color: var(--button-solid-border);
    box-shadow: var(--button-solid-shadow);
  }

  .button--solid:hover {
    background-color: var(--button-solid-hover-bg, var(--button-solid-bg));
    color: var(--button-solid-hover-fg, var(--button-solid-fg));
    border-color: var(--button-solid-hover-border, var(--button-solid-border));
    box-shadow: var(--button-solid-hover-shadow, var(--button-solid-shadow));
    transform: translateY(var(--button-solid-hover-lift, -1px)) skewX(var(--button-skew, 0deg));
  }

  .button--solid:active {
    box-shadow: var(--button-solid-active-shadow, var(--button-solid-shadow));
    transform: skewX(var(--button-skew, 0deg));
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .button--solid:hover {
      transition: none;
      transform: skewX(var(--button-skew, 0deg));
    }
  }

  .button--outline {
    background: var(--button-outline-bg);
    color: var(--button-outline-fg);
    border-color: var(--button-outline-border);
  }

  .button--outline:hover {
    background: var(--button-outline-hover-bg);
    color: var(--button-outline-hover-fg);
  }

  .button--ghost {
    background: var(--button-ghost-bg);
    color: var(--button-ghost-fg);
    border-color: var(--button-ghost-border);
    text-decoration: dotted underline;
  }

  .button--ghost:hover {
    background: var(--button-ghost-hover-bg);
    color: var(--button-ghost-hover-fg);
    text-decoration: none;
  }

  .button--xs {
    padding: 0.2rem 0.5rem;
    font-size: var(--size-xs);
    font-weight: 400;
  }
  .button--sm {
    padding: 0.45rem 1rem;
    font-size: var(--size-sm);
    box-shadow: 0;
  }

  .button--md {
    padding: 0.65rem 1.5rem;
    font-size: var(--size-md);
  }

  .button--lg {
    padding: 0.85rem 1.9rem;
    font-size: var(--size-lg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
