---
/*
GoogleRating — the overall Google rating, linked to the business profile.
Props:
- rating?: number — 0 to 5. Nothing renders without it (never show a made-up number).
- count?: number — number of reviews
- href?: string — Google profile or reviews page (opens in a new tab)
- variant?: "badge" | "inline" | "mini" | "sticker"
    sticker: a tilted label to lay over a photo (place it with CSS from the page);
    the tilt is --rating-sticker-rotate (default 0deg) and stops with reduced motion
- label?: string — "{count} Google reviews"
- srTemplate?: string — "Rated {rating} out of 5 on Google, {count} reviews"
- newTabLabel?: string — "(opens in a new tab)"
- locale?: string — number format, such as "fr-CA" (4,9) or "en-CA" (4.9)
- id?: string
- class?: string
- style?: string
Notes:
- Feed it the same data as GoogleReviews, refreshed at build time.
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { mergeClasses } from "../../utils/style.js";
import StarRating from "../StarRating/StarRating.astro";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  rating: z.number().min(0).max(5).optional(),
  count: z.number().int().nonnegative().optional(),
  href: z.string().optional(),
  variant: z.enum(["badge", "inline", "mini", "sticker"]).default("badge"),
  label: z.string().default("{count} Google reviews"),
  srTemplate: z.string().default("Rated {rating} out of 5 on Google, {count} reviews"),
  newTabLabel: z.string().default("(opens in a new tab)"),
  locale: z.string().default("en-CA")
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  rating,
  count,
  href,
  variant,
  label,
  srTemplate,
  newTabLabel,
  locale,
  ...rest
} = parseProps(Schema, Astro.props, { component: "GoogleRating" });

const hasRating = typeof rating === "number";
const value = hasRating
  ? new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(
      rating
    )
  : "";
const countText = typeof count === "number" ? new Intl.NumberFormat(locale).format(count) : "";
const visibleLabel = label.replace("{count}", countText).trim();
const srText = srTemplate.replace("{rating}", value).replace("{count}", countText);
const Tag = href ? "a" : "div";
---

{
  hasRating && (
    <Tag
      id={id}
      class={mergeClasses("google-rating", `google-rating--${variant}`, className)}
      style={style}
      href={href}
      target={href ? "_blank" : undefined}
      rel={href ? "noopener noreferrer" : undefined}
      {...rest}
    >
      <span class="google-rating__value" aria-hidden="true">
        {value}
      </span>
      <span class="google-rating__detail" aria-hidden="true">
        <StarRating
          rating={rating}
          size={variant === "badge" || variant === "sticker" ? "sm" : "xs"}
          srText=""
        />
        {variant !== "mini" && <span class="google-rating__label">{visibleLabel}</span>}
        {variant === "mini" && <span class="google-rating__label">Google</span>}
      </span>
      <span class="sr-only">
        {srText}
        {href && ` ${newTabLabel}`}
      </span>
    </Tag>
  )
}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .google-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-fg);
    text-decoration: none;
  }

  .google-rating__detail {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .google-rating__value {
    font-family: var(--font-display);
    text-transform: var(--type-heading-transform, none);
    font-size: 2.25rem;
    line-height: 1;
  }

  .google-rating__label {
    font-size: 0.8125rem;
    color: var(--muted-text, color-mix(in srgb, var(--color-muted) 78%, var(--color-fg)));
  }

  a.google-rating:hover .google-rating__label {
    color: var(--accent-text, var(--color-accent));
    text-decoration: underline;
  }

  a.google-rating:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .google-rating--badge {
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0);
    background: var(--google-rating-bg, rgb(255 255 255));
  }

  .google-rating--inline {
    gap: 0.5rem;
  }

  .google-rating--inline .google-rating__value {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: var(--weight-bold, 700);
  }

  .google-rating--inline .google-rating__detail {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  .google-rating--inline .google-rating__label {
    font-size: 0.9375rem;
  }

  .google-rating--mini {
    gap: 0.4375rem;
    padding: 0.4375rem 0.6875rem;
    background: var(--google-rating-bg, rgb(255 255 255));
    border-radius: var(--radius-sm, 0);
  }

  .google-rating--mini .google-rating__value {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold, 700);
  }

  .google-rating--mini .google-rating__detail {
    flex-direction: row;
    align-items: center;
    gap: 0.375rem;
  }

  .google-rating--mini .google-rating__label {
    font-size: 0.8125rem;
    color: inherit;
  }

  .google-rating--sticker {
    padding: 0.75rem 1rem;
    border: var(--rating-sticker-border, 2px solid var(--color-fg));
    background: var(--rating-sticker-bg, var(--google-rating-bg, rgb(255 255 255)));
    box-shadow: var(--rating-sticker-shadow, none);
    color: var(--rating-sticker-fg, var(--color-fg));
    transform: rotate(var(--rating-sticker-rotate, 0deg));
  }

  .google-rating--sticker .google-rating__label {
    color: inherit;
  }

  .google-rating :global(.star-rating) {
    margin: 0;
  }
</style>
