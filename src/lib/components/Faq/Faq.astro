---
/*
Faq — questions and answers with native <details>: works without JavaScript and
with the keyboard. Use Accordion for other kinds of collapsible content.
Props:
- heading?: string
- items: { question: string, answer: string }[] — answer allows HTML, trusted content only
- openFirst?: boolean
- actions?: { label: string, href?: string, variant?: "solid"|"outline"|"ghost" }[]
- tone?: "default" | "surface"
- flush?: boolean
- id?: string
- class?: string
- style?: string
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { mergeClasses } from "../../utils/style.js";
import Band from "../Band/Band.astro";
import Button from "../Button/Button.astro";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  heading: z.string().optional(),
  items: z.array(z.looseObject({ question: z.string(), answer: z.string() })).default([]),
  openFirst: z.boolean().default(true),
  actions: z
    .array(
      z.looseObject({
        label: z.string(),
        href: z.string().optional(),
        variant: z.enum(["solid", "outline", "ghost"]).optional()
      })
    )
    .default([]),
  tone: z.enum(["default", "surface"]).default("default"),
  flush: z.boolean().default(false)
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  heading,
  items,
  openFirst,
  actions,
  tone,
  flush
} = parseProps(Schema, Astro.props, { component: "Faq" });

const headingId = nextId("faq");
---

<Band
  id={id}
  class={mergeClasses("faq", className)}
  style={style}
  tone={tone}
  flush={flush}
  labelledby={heading ? headingId : undefined}
>
  <div class:list={["faq__grid", heading && "faq__grid--titled"]}>
    {
      heading && (
        <h2 id={headingId} class="faq__title">
          {heading}
        </h2>
      )
    }
    <div>
      <div class="faq__list">
        {
          items.map((item, index) => (
            <details class="faq__item" open={openFirst && index === 0}>
              <summary>
                <span>{item.question}</span>
                <svg
                  aria-hidden="true"
                  width="28"
                  height="28"
                  viewBox="0 0 28 28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.5"
                >
                  <path d="M14 4v20M4 14h20" />
                </svg>
              </summary>
              <div class="faq__answer" set:html={item.answer} />
            </details>
          ))
        }
      </div>
      {
        actions.length > 0 && (
          <div class="faq__actions">
            {actions.map((b) => (
              <Button label={b.label} href={b.href} variant={b.variant ?? "ghost"} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Band>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .faq__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h2, clamp(2rem, 4vw, 3rem));
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: var(--type-h2-line, 1.1);
    letter-spacing: var(--type-h2-tracking, normal);
    overflow-wrap: break-word;
  }

  .faq__list {
    border-top: 2px solid currentColor;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: 1fr 1.75rem;
    gap: 1rem;
    align-items: start;
    min-height: 2.75rem;
    padding-block: 1.125rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.3125rem, 2.3vw, 1.875rem);
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: 1.15;
    letter-spacing: var(--type-h3-tracking, normal);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .faq__item summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .faq__item summary svg {
    margin-block-start: 0.125rem;
    transition: transform 150ms ease-out;
  }

  .faq__item[open] summary svg {
    transform: rotate(45deg);
  }

  .faq__answer {
    max-width: 70ch;
    padding: 0 2.75rem 1.375rem 0;
  }

  .faq__answer :global(p) {
    margin: 0;
  }

  .faq__actions {
    margin-block-start: 1.25rem;
  }

  @media (min-width: 56.25rem) {
    .faq__grid--titled {
      grid-template-columns: 4fr 8fr;
      gap: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item summary svg {
      transition: none;
    }
  }
</style>
