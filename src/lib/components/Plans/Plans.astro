---
/*
Plans — pricing cards. With `billing`, real radio buttons switch the displayed
price with CSS only, and every price stays in the page without JavaScript.
Props:
- heading?: string
- note?: string
- billing?: { legend: string, first: string, second: string }
- currency?: string
- items: {
    eyebrow?: string,
    name: string,
    price?: string,        // amount for the first payment option, or free text
    priceSecond?: string,  // amount for the second payment option
    note?: string,
    noteSecond?: string,
    features?: string[],
    cta?: { label: string, href?: string },
    featured?: boolean
  }[]
- tone?: "default" | "surface"
- flush?: boolean
- id?: string
- class?: string
- style?: string
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { nextId } from "../../utils/id.js";
import { mergeClasses } from "../../utils/style.js";
import Band from "../Band/Band.astro";
import Button from "../Button/Button.astro";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  heading: z.string().optional(),
  note: z.string().optional(),
  billing: z.looseObject({ legend: z.string(), first: z.string(), second: z.string() }).optional(),
  currency: z.string().default("CA$"),
  items: z
    .array(
      z.looseObject({
        eyebrow: z.string().optional(),
        name: z.string(),
        price: z.string().optional(),
        priceSecond: z.string().optional(),
        note: z.string().optional(),
        noteSecond: z.string().optional(),
        features: z.array(z.string()).default([]),
        cta: z.looseObject({ label: z.string(), href: z.string().optional() }).optional(),
        featured: z.boolean().default(false)
      })
    )
    .default([]),
  tone: z.enum(["default", "surface"]).default("default"),
  flush: z.boolean().default(false)
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  heading,
  note,
  billing,
  currency,
  items,
  tone,
  flush
} = parseProps(Schema, Astro.props, { component: "Plans" });

const headingId = nextId("plans");
const radioName = nextId("plans-billing");
const isAmount = (value?: string) => Boolean(value && /^[\d\s.,]+$/.test(value));
---

<Band
  id={id}
  class={mergeClasses("plans", className)}
  style={style}
  tone={tone}
  flush={flush}
  labelledby={heading ? headingId : undefined}
>
  {
    heading && (
      <h2 id={headingId} class="plans__title">
        {heading}
      </h2>
    )
  }
  {
    billing && (
      <fieldset class="plans__billing">
        <legend>{billing.legend}</legend>
        <div class="plans__segment">
          <label>
            <input type="radio" name={radioName} value="first" checked />
            <span>{billing.first}</span>
          </label>
          <label>
            <input type="radio" name={radioName} value="second" />
            <span>{billing.second}</span>
          </label>
        </div>
      </fieldset>
    )
  }
  {note && <p class="plans__note">{note}</p>}
  <ul class:list={["plans__list", items.length >= 3 && "plans__list--3"]}>
    {
      items.map((item) => (
        <li>
          <article class:list={["plan", item.featured && "plan--featured"]}>
            {item.eyebrow && <p class="plan__eyebrow">{item.eyebrow}</p>}
            <h3 class="plan__name">{item.name}</h3>
            {isAmount(item.price) ? (
              <p class="plan__price plan__price--first">
                <data value={item.price}>{item.price}</data>
                <small> {currency}</small>
              </p>
            ) : (
              <p class="plan__price plan__price--text">{item.price}</p>
            )}
            {item.priceSecond && (
              <p class="plan__price plan__price--second">
                <data value={item.priceSecond}>{item.priceSecond}</data>
                <small> {currency}</small>
              </p>
            )}
            {item.note && (
              <p class:list={["plan__note", item.noteSecond && "plan__price--first"]}>
                {item.note}
              </p>
            )}
            {item.noteSecond && <p class="plan__note plan__price--second">{item.noteSecond}</p>}
            {item.features.length > 0 && (
              <ul class="plan__features">
                {item.features.map((feature) => (
                  <li>
                    <svg
                      aria-hidden="true"
                      width="18"
                      height="18"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path d="M2 8l4 4 8-9" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            )}
            {item.cta && (
              <div class="plan__cta">
                <Button
                  label={item.cta.label}
                  href={item.cta.href}
                  variant={item.featured ? "solid" : "outline"}
                />
              </div>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .plans__title {
    max-width: 22ch;
    margin: 0 0 clamp(1.75rem, 4vw, 3.5rem);
    font-family: var(--font-display);
    font-size: var(--type-h2, clamp(2rem, 4vw, 3rem));
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: var(--type-h2-line, 1.1);
    letter-spacing: var(--type-h2-tracking, normal);
  }

  .plans__billing {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
    padding: 0;
    border: 0;
  }

  .plans__billing legend {
    margin-block-end: 0.5rem;
    padding: 0;
    font-size: 1.0625rem;
    font-weight: var(--weight-bold);
  }

  .plans__segment {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    max-width: 100%;
    border: 2px solid currentColor;
  }

  .plans__segment label {
    display: block;
    cursor: pointer;
  }

  .plans__segment input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .plans__segment span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1rem;
    font-size: 1.0625rem;
    font-weight: var(--weight-bold);
    line-height: 1.1;
    text-align: center;
  }

  .plans__segment input:checked + span {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .plans__segment input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .plans__note {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .plans__list {
    display: grid;
    gap: clamp(1.25rem, 2.6vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.375rem, 2.6vw, 2rem);
    background: var(--band-surface-bg, var(--color-surface));
    color: var(--color-fg);
  }

  .plan--featured {
    --color-fg: var(--color-inverse-fg);
    --color-muted: var(--plan-featured-muted, var(--color-inverse-fg));
    background: var(--color-inverse-surface);
    color: var(--color-inverse-fg);
  }

  .plan__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    line-height: 1.35;
    color: var(--color-muted);
  }

  .plan__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h3, clamp(1.5rem, 2.6vw, 2.125rem));
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: var(--type-h3-line, 1.15);
    letter-spacing: var(--type-h3-tracking, normal);
  }

  .plan__price {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 4.75rem);
    font-weight: var(--type-heading-weight, var(--weight-bold));
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .plan__price small {
    font-size: 0.42em;
    letter-spacing: -0.02em;
  }

  .plan__price--text {
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    line-height: 1;
  }

  .plan__price--second {
    display: none;
  }

  .plans:has(input[value="second"]:checked) .plan__price--first {
    display: none;
  }

  .plans:has(input[value="second"]:checked) .plan__price--second {
    display: block;
  }

  .plan__note {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .plan__features {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan__features li {
    display: grid;
    grid-template-columns: 1.125rem 1fr;
    gap: 0.625rem;
    line-height: 1.35;
  }

  .plan__features svg {
    margin-block-start: 0.25rem;
    color: var(--color-accent);
  }

  .plan__cta {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .plan__cta :global(.button) {
    width: 100%;
  }

  @media (min-width: 45rem) {
    .plans__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 62.5rem) {
    .plans__list--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
