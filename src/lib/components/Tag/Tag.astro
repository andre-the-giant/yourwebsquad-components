---
/*
Tag — small label for a status, such as "Coming soon". Not interactive.
Props:
- label: string
- tone?: "neutral" | "inverse" | "success" | "muted"
- dot?: boolean — a small square before the word (the word stays: colour is never the only cue)
Theme variables: --tag-font, --tag-font-size, --tag-transform, --tag-letter-spacing,
--tag-border, --tag-success-bg, --tag-success-fg, --tag-muted-bg, --tag-muted-fg, --tag-dot
- id?: string
- class?: string
- style?: string
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { mergeClasses } from "../../utils/style.js";

const Schema = z.looseObject({
  id: z.string().optional(),
  class: z.string().optional(),
  style: z.string().optional(),
  label: z.string(),
  tone: z.enum(["neutral", "inverse", "success", "muted"]).default("neutral"),
  dot: z.boolean().default(false)
});

type Props = z.input<typeof Schema>;

const {
  id,
  class: className,
  style,
  label,
  tone,
  dot,
  ...rest
} = parseProps(Schema, Astro.props, { component: "Tag" });
---

<span
  id={id}
  class={mergeClasses("tag", `tag--${tone}`, dot && "tag--dot", className)}
  style={style}
  {...rest}
>
  {dot && <span class="tag__dot" aria-hidden="true" />}
  {label}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.4375rem;
    border: var(--tag-border, 0);
    font-family: var(--tag-font, var(--font-mono));
    font-size: var(--tag-font-size, 0.8125rem);
    letter-spacing: var(--tag-letter-spacing, normal);
    text-transform: var(--tag-transform, none);
    line-height: 1;
  }

  .tag__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--tag-dot, currentColor);
  }

  .tag--success {
    background: var(--tag-success-bg, rgba(var(--color-success-rgb), 0.12));
    color: var(--tag-success-fg, var(--color-success-text));
  }

  .tag--muted {
    background: var(--tag-muted-bg, var(--band-surface-bg, var(--color-surface)));
    color: var(--tag-muted-fg, var(--muted-text, var(--color-fg)));
  }

  .tag--neutral {
    background: var(--band-surface-bg, var(--color-surface));
    color: var(--color-fg);
  }

  .tag--inverse {
    background: var(--color-inverse-surface);
    color: var(--color-inverse-fg);
  }
</style>
