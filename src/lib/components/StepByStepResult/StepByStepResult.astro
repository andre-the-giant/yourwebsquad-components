---
/*
StepByStepResult — the result screen of StepByStepWizard (put it in its `result` slot).
Props:
- variant?: "range" | "total" | "text"
- eyebrow?: string — "Your estimate"
- when?: { step: string, is: string | string[] } — shown only for that answer, so one
  wizard can hold a result per path (a total for a rental, a range for works)
range:
- pricing: {
    base: { min: number, max: number },
    ranges?: { step: string, values: { [value]: { min: number, max: number } } }[]
        // replaces the base from an answer; the first list with a match wins
    rules?: { [stepId]: { [value]: { factor?: number, add?: number, widen?: number } } },
    round?: number             // rounding step, default 500
  }
- duration?: { base: { min: number, max: number }, rules?: { [stepId]: { [value]: { add?: number } } } }
- durationTemplate?: string — "{min} to {max} weeks"
- currency?: string — ISO code, default "CAD"
- locale?: string — number format ("fr-CA" → 22 000 $, "en-CA" → $22,000)
- unsureValue?: string — option value meaning "not sure yet" (default "unsure")
- wideAfter?: number — from this many unsure answers, the range widens (default 2)
- wideNote?: string — sentence shown when it widens
- taxNote?: string — "taxes extra"
total:
- total: {
    lines: {
      label: string,     // "{label:machine}, {label:duration}" puts in the chosen labels
      when?: { step, is },
      amount?: number,   // a fixed amount (a delivery trip)
      table?: { step: string, values: { [value]: number | { [column]: number } },
                column?: { step: string, map: { [value]: column } } },
        // price read from a table: by the answer of `step`, then by a column picked
        // from another answer (day or week price picked by the duration)
      quantity?: number | { step: string, map: { [value]: number } },
      percent?: number   // a percentage of the lines above it (damage protection 12 %)
    }[],
    round?: number,      // rounding of the total, default 5
    fallback?: string    // shown when no line has a price ("Price on request")
  }
- totalTemplate?: string — "about {total}"
text:
- outcomeStep: string — the step whose answer picks the text
- outcomes: { [value]: { title: string, text: string } }
Common:
- class?: string
- style?: string
Slots:
- default — notes and "what is included", under the figure
- actions — buttons
Hidden field: any input[data-stepbystep-result] inside the wizard receives "min-max"
(range) or the total, from the result that is shown.
States: calculating (handled by the wizard), shown, "review my answers" (StepByStepSummary).
*/
import { z } from "zod";
import { parseProps } from "../../utils/props.js";
import { mergeClasses } from "../../utils/style.js";

const Rule = z.looseObject({
  factor: z.number().optional(),
  add: z.number().optional(),
  widen: z.number().optional()
});

const Schema = z.looseObject({
  class: z.string().optional(),
  style: z.string().optional(),
  variant: z.enum(["range", "total", "text"]).default("range"),
  when: z
    .looseObject({ step: z.string(), is: z.union([z.string(), z.array(z.string())]) })
    .optional(),
  total: z
    .looseObject({
      lines: z.array(
        z.looseObject({
          label: z.string(),
          when: z
            .looseObject({ step: z.string(), is: z.union([z.string(), z.array(z.string())]) })
            .optional(),
          amount: z.number().optional(),
          table: z
            .looseObject({
              step: z.string(),
              values: z.record(z.string(), z.union([z.number(), z.record(z.string(), z.number())])),
              column: z
                .looseObject({ step: z.string(), map: z.record(z.string(), z.string()) })
                .optional()
            })
            .optional(),
          quantity: z
            .union([
              z.number(),
              z.looseObject({ step: z.string(), map: z.record(z.string(), z.number()) })
            ])
            .optional(),
          percent: z.number().optional()
        })
      ),
      round: z.number().positive().default(5),
      fallback: z.string().default("Price on request")
    })
    .optional(),
  totalTemplate: z.string().default("about {total}"),
  eyebrow: z.string().default("Your estimate"),
  pricing: z
    .looseObject({
      base: z.looseObject({ min: z.number(), max: z.number() }),
      rules: z.record(z.string(), z.record(z.string(), Rule)).default({}),
      ranges: z
        .array(
          z.looseObject({
            step: z.string(),
            values: z.record(z.string(), z.looseObject({ min: z.number(), max: z.number() }))
          })
        )
        .default([]),
      round: z.number().positive().default(500)
    })
    .optional(),
  duration: z
    .looseObject({
      base: z.looseObject({ min: z.number(), max: z.number() }),
      rules: z.record(z.string(), z.record(z.string(), Rule)).default({})
    })
    .optional(),
  durationTemplate: z.string().default("{min} to {max} weeks"),
  currency: z.string().default("CAD"),
  locale: z.string().default("en-CA"),
  unsureValue: z.string().default("unsure"),
  wideAfter: z.number().int().positive().default(2),
  wideNote: z.string().default("Wide range: some answers are still open."),
  taxNote: z.string().default("taxes extra"),
  outcomeStep: z.string().optional(),
  outcomes: z.record(z.string(), z.looseObject({ title: z.string(), text: z.string() })).default({})
});

type Props = z.input<typeof Schema>;

const {
  class: className,
  style,
  variant,
  when,
  total,
  totalTemplate,
  eyebrow,
  pricing,
  duration,
  durationTemplate,
  currency,
  locale,
  unsureValue,
  wideAfter,
  wideNote,
  taxNote,
  outcomeStep,
  outcomes
} = parseProps(Schema, Astro.props, { component: "StepByStepResult" });

const config = {
  variant,
  when,
  total,
  totalTemplate,
  pricing,
  duration,
  durationTemplate,
  currency,
  locale,
  unsureValue,
  wideAfter,
  outcomeStep,
  outcomes
};
---

<section
  class={mergeClasses("sbs-result", `sbs-result--${variant}`, className)}
  style={style}
  data-sbs-result
  data-config={JSON.stringify(config)}
  hidden={when ? true : undefined}
>
  <h2 class="sbs-result__eyebrow" tabindex="-1">{eyebrow}</h2>
  <p class="sbs-result__line" data-line></p>
  {
    variant === "total" ? (
      <Fragment>
        <p class="sbs-result__figure" data-figure />
        <dl class="sbs-result__lines" data-lines />
        <p class="sbs-result__meta">
          <span>{taxNote}</span>
        </p>
      </Fragment>
    ) : variant === "range" ? (
      <Fragment>
        <p class="sbs-result__figure" data-figure />
        <p class="sbs-result__meta">
          <span data-duration />
          <span>{taxNote}</span>
        </p>
        <p class="sbs-result__wide" data-wide hidden>
          {wideNote}
        </p>
      </Fragment>
    ) : (
      <Fragment>
        <p class="sbs-result__title" data-title />
        <p class="sbs-result__text" data-text />
      </Fragment>
    )
  }
  {
    Astro.slots.has("default") && (
      <div class="sbs-result__notes">
        <slot />
      </div>
    )
  }
  {
    Astro.slots.has("actions") && (
      <div class="sbs-result__actions">
        <slot name="actions" />
      </div>
    )
  }
</section>

<script>
  type Rule = { factor?: number; add?: number; widen?: number };
  type Answer = string | string[];
  type StepData = { id: string; title: string; options: { value: string; label: string }[] };
  type When = { step: string; is: string | string[] };
  type Line = {
    label: string;
    when?: When;
    amount?: number;
    table?: {
      step: string;
      values: Record<string, number | Record<string, number>>;
      column?: { step: string; map: Record<string, string> };
    };
    quantity?: number | { step: string; map: Record<string, number> };
    percent?: number;
  };

  const first = (value: Answer | undefined) => (Array.isArray(value) ? value[0] : value);
  const matches = (when: When | undefined, answers: Record<string, Answer>) => {
    if (!when) return true;
    const wanted = Array.isArray(when.is) ? when.is : [when.is];
    const value = answers[when.step];
    return Array.isArray(value)
      ? value.some((v) => wanted.includes(v))
      : wanted.includes(value ?? "");
  };

  for (const box of document.querySelectorAll<HTMLElement>("[data-sbs-result]")) {
    const root = box.closest<HTMLElement>("[data-stepbystep]");
    if (!root) continue;
    const c = JSON.parse(box.dataset.config ?? "{}");
    const steps: StepData[] = JSON.parse(root.dataset.steps ?? "[]");

    const apply = (
      base: { min: number; max: number },
      rules: Record<string, Record<string, Rule>>,
      answers: Record<string, Answer>
    ) => {
      let { min, max } = base;
      for (const [stepId, answer] of Object.entries(answers)) {
        const rule = rules?.[stepId]?.[first(answer) ?? ""];
        if (!rule) continue;
        if (rule.factor) {
          min *= rule.factor;
          max *= rule.factor;
        }
        if (rule.add) {
          min += rule.add;
          max += rule.add;
        }
        if (rule.widen) {
          min *= 1 - rule.widen / 2;
          max *= 1 + rule.widen;
        }
      }
      return { min, max };
    };

    const money = new Intl.NumberFormat(c.locale, {
      style: "currency",
      currency: c.currency,
      maximumFractionDigits: 0
    });
    const format = (n: number) => money.format(n).replace(/\s/g, "\u00a0");
    const labelOf = (stepId: string, answers: Record<string, Answer>) => {
      const step = steps.find((s) => s.id === stepId);
      const value = answers[stepId];
      const values = Array.isArray(value) ? value : value ? [value] : [];
      return values.map((v) => step?.options.find((o) => o.value === v)?.label ?? v).join(", ");
    };

    // Line by line: table price × quantity, fixed amounts, percentages of the lines above
    const totalOf = (answers: Record<string, Answer>) => {
      const rows: { label: string; amount: number }[] = [];
      for (const line of (c.total?.lines ?? []) as Line[]) {
        if (!matches(line.when, answers)) continue;
        let amount: number | undefined;
        if (typeof line.percent === "number") {
          amount = (rows.reduce((sum, row) => sum + row.amount, 0) * line.percent) / 100;
        } else if (line.table) {
          const entry = line.table.values[first(answers[line.table.step]) ?? ""];
          if (typeof entry === "number") amount = entry;
          else if (entry && line.table.column) {
            const column = line.table.column.map[first(answers[line.table.column.step]) ?? ""];
            amount = column ? entry[column] : undefined;
          }
        } else if (typeof line.amount === "number") {
          amount = line.amount;
        }
        if (typeof amount !== "number") continue;
        const qty =
          typeof line.quantity === "number"
            ? line.quantity
            : line.quantity
              ? (line.quantity.map[first(answers[line.quantity.step]) ?? ""] ?? 1)
              : 1;
        rows.push({
          label: line.label.replace(/\{label:([\w-]+)\}/g, (_, id) => labelOf(id, answers)),
          amount: amount * qty
        });
      }
      return rows;
    };

    root.addEventListener("stepbystep:complete", (event) => {
      const answers: Record<string, Answer> = (event as CustomEvent).detail?.answers ?? {};
      box.hidden = !matches(c.when, answers);
      if (box.hidden) return;
      const line = box.querySelector<HTMLElement>("[data-line]");
      if (line) {
        line.textContent = steps
          .flatMap((s) => {
            const value = answers[s.id];
            const values = Array.isArray(value) ? value : value ? [value] : [];
            return values.map((v) => s.options.find((o) => o.value === v));
          })
          .filter((o) => o && o.value !== c.unsureValue)
          .map((o) => o!.label)
          .join(" · ");
      }

      if (c.variant === "total") {
        const rows = totalOf(answers);
        const list = box.querySelector<HTMLElement>("[data-lines]")!;
        list.replaceChildren(
          ...rows.flatMap((row) => {
            const dt = document.createElement("dt");
            dt.textContent = row.label;
            const dd = document.createElement("dd");
            dd.textContent = format(row.amount);
            return [dt, dd];
          })
        );
        const step = c.total?.round ?? 5;
        const sum = Math.round(rows.reduce((s, row) => s + row.amount, 0) / step) * step;
        box.querySelector("[data-figure]")!.textContent = rows.length
          ? c.totalTemplate.replace("{total}", format(sum))
          : (c.total?.fallback ?? "");
        root
          .querySelectorAll<HTMLInputElement>("input[data-stepbystep-result]")
          .forEach((input) => {
            input.value = rows.length ? String(sum) : "";
          });
        return;
      }

      if (c.variant === "text") {
        const outcome = c.outcomes?.[first(answers[c.outcomeStep]) ?? ""];
        box.querySelector("[data-title]")!.textContent = outcome?.title ?? "";
        box.querySelector("[data-text]")!.textContent = outcome?.text ?? "";
        return;
      }

      if (!c.pricing) return;
      // A range picked from an answer replaces the base
      let base = c.pricing.base;
      for (const source of c.pricing.ranges ?? []) {
        const found = source.values[first(answers[source.step]) ?? ""];
        if (found) {
          base = found;
          break;
        }
      }
      let price = apply(base, c.pricing.rules, answers);
      const unsure = Object.values(answers).filter((v) => v === c.unsureValue).length;
      const wide = unsure >= c.wideAfter;
      if (wide) price = { min: price.min * 0.92, max: price.max * 1.15 };
      const step = c.pricing.round ?? 500;
      const min = Math.floor(price.min / step) * step;
      const max = Math.ceil(price.max / step) * step;
      box.querySelector("[data-figure]")!.textContent = `${format(min)} – ${format(max)}`;
      box.querySelector<HTMLElement>("[data-wide]")!.hidden = !wide;

      if (c.duration) {
        const d = apply(c.duration.base, c.duration.rules, answers);
        box.querySelector("[data-duration]")!.textContent = c.durationTemplate
          .replace("{min}", String(Math.round(d.min)))
          .replace("{max}", String(Math.round(d.max)));
      }

      root.querySelectorAll<HTMLInputElement>("input[data-stepbystep-result]").forEach((input) => {
        input.value = `${min}-${max}`;
      });
    });
  }
</script>

<style>
  .sbs-result {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .sbs-result__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-semibold, 600);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-text, var(--color-accent));
  }

  .sbs-result__eyebrow:focus {
    outline: none;
  }

  .sbs-result__line {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted-text, color-mix(in srgb, var(--color-muted) 78%, var(--color-fg)));
  }

  .sbs-result__figure,
  .sbs-result__title {
    margin: 0;
    font-family: var(--font-display);
    text-transform: var(--type-heading-transform, none);
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.02;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .sbs-result__figure {
    white-space: nowrap;
  }

  .sbs-result[hidden] {
    display: none;
  }

  .sbs-result__lines {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
    margin: 0;
    max-width: 32rem;
    border-top: 2px solid currentColor;
  }

  .sbs-result__lines dt,
  .sbs-result__lines dd {
    margin: 0;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .sbs-result__lines dd {
    padding-inline-start: 1rem;
    text-align: end;
    font-weight: var(--weight-semibold, 600);
    font-variant-numeric: tabular-nums;
  }

  .sbs-result__lines:empty {
    display: none;
  }

  .sbs-result__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    font-size: 1.0625rem;
  }

  .sbs-result__meta span:first-child:not(:empty)::after {
    content: " ·";
  }

  .sbs-result__wide {
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--color-accent-muted);
    font-size: 0.9375rem;
  }

  .sbs-result__text {
    margin: 0;
    font-size: var(--type-lead, 1.125rem);
  }

  .sbs-result__notes {
    display: grid;
    gap: 1rem;
  }

  .sbs-result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 30rem) {
    .sbs-result__figure {
      white-space: normal;
    }
  }
</style>
