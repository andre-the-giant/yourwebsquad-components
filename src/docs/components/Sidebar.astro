---
import { categories, levels } from "../data/components.js";

const { title = "", items = [] } = Astro.props;
const currentPath = (Astro.url?.pathname ?? "").replace(/\/$/, "");

const groups = categories
  .map((category) => ({
    category,
    items: items
      .filter((item) => item.category === category)
      .sort((a, b) => a.name.localeCompare(b.name))
  }))
  .filter((group) => group.items.length > 0);

const searchText = (item) =>
  [item.name, item.description, item.category, levels[item.level], ...(item.tags ?? [])]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
---

<nav class="sidebar" aria-label={title || "Components"}>
  {title && <div class="sidebar__title">{title}</div>}

  {
    items.length > 0 && (
      <div class="sidebar__search">
        <label class="sidebar__search-label" for="sidebar-search">
          Search components
        </label>
        <input
          id="sidebar-search"
          class="sidebar__search-input"
          type="search"
          placeholder="Search…"
          autocomplete="off"
          data-sidebar-search
        />
        <p class="sidebar__no-results" data-sidebar-empty hidden>
          No match.
        </p>
      </div>
    )
  }

  {
    groups.map((group) => (
      <div class="sidebar__group" data-sidebar-group>
        <div class="sidebar__group-title">{group.category}</div>
        <ul class="sidebar__list">
          {group.items.map((item) => (
            <li data-sidebar-item data-search={searchText(item)}>
              <a
                class={`sidebar__link${currentPath === item.href ? " is-active" : ""}`}
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                <span>{item.name}</span>
                {item.level && (
                  <span class="sidebar__tag" title={levels[item.level]}>
                    {levels[item.level]}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  {items.length === 0 && <div class="sidebar__empty">No components yet.</div>}
</nav>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-sidebar-search]");
  const empty = document.querySelector<HTMLElement>("[data-sidebar-empty]");
  input?.addEventListener("input", () => {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-sidebar-group]").forEach((group) => {
      let groupShown = 0;
      group.querySelectorAll<HTMLElement>("[data-sidebar-item]").forEach((item) => {
        const text = item.dataset.search ?? "";
        const match = terms.every((t) => text.includes(t));
        item.hidden = !match;
        if (match) groupShown++;
      });
      group.hidden = groupShown === 0;
      shown += groupShown;
    });
    if (empty) empty.hidden = shown > 0;
  });
</script>
<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar__title {
    font-size: var(--size-sm);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted);
  }

  .sidebar__list {
    display: grid;
    gap: var(--space-2);
  }

  .sidebar__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar__group-title {
    font-size: var(--size-xs);
    text-transform: uppercase;
    color: var(--color-muted);
    letter-spacing: 0.12em;
    padding: var(--space-1) var(--space-2);
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.25rem 0.5rem;
    border-radius: 0;
    border: 1px solid transparent;
    font-size: var(--size-xs);
    transition:
      border-color 150ms ease,
      background 150ms ease;
  }

  .sidebar__link:hover {
    border-color: var(--color-border);
    background: var(--color-accent-muted);
  }

  .sidebar__link.is-active {
    border-color: var(--color-accent);
    box-shadow: none;
  }

  .sidebar__tag {
    flex-shrink: 0;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .sidebar__empty {
    color: var(--color-muted);
    font-size: var(--size-sm);
  }

  .sidebar__search {
    display: grid;
    gap: var(--space-1);
  }

  .sidebar__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .sidebar__search-input {
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: inherit;
    font: inherit;
    font-size: var(--size-xs);
  }

  .sidebar__search-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .sidebar__no-results {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--size-xs);
  }

  [hidden] {
    display: none !important;
  }
</style>
