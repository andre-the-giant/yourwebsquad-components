---
import "../styles/reset.css";
import "@lib/styles/tokens.css";
import "@lib/themes/plein-jour.css";
import "@lib/themes/marbre.css";
import { themes, defaultTheme } from "@lib/themes/index.js";
import Sidebar from "../components/Sidebar.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import ywsLogo from "../images/yws_logo.svg?raw";
import ywsLogoDark from "../images/yws_logo_dark.svg?raw";

const themeIds = themes.map((theme) => theme.id);

const { title = "Your Web Squad", description = "Component library", items = [] } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@500,700,900&display=swap"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Marcellus&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ themeIds, defaultTheme }}>
      // Runs before the first paint, so that the page never flashes in the wrong theme.
      (() => {
        const fromUrl = new URLSearchParams(location.search).get("theme");
        let saved = null;
        try {
          saved = localStorage.getItem("yws-theme");
        } catch {
          // Ignore storage errors in restricted contexts.
        }
        const wanted = fromUrl || saved;
        document.documentElement.setAttribute(
          "data-theme",
          themeIds.includes(wanted) ? wanted : defaultTheme
        );
      })();
    </script>
  </head>
  <body>
    <div class="docs-shell">
      <aside class="docs-sidebar">
        <div class="brand">
          <div
            class="brand__logo brand__logo--light"
            aria-label="Your Web Squad"
            role="img"
            set:html={ywsLogo}
          />
          <div
            class="brand__logo brand__logo--dark"
            aria-label="Your Web Squad"
            role="img"
            set:html={ywsLogoDark}
          />
        </div>
        <Sidebar items={items} />
      </aside>
      <main class="docs-main">
        <header class="docs-header">
          <div>
            <p class="docs-kicker">Library</p>
            <h1 class="docs-title">{title}</h1>
            <p class="docs-subtitle">{description}</p>
          </div>
          <ThemeSwitcher />
        </header>
        <section class="docs-content">
          <slot />
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --docs-font: "Satoshi", "Helvetica Neue", Arial, sans-serif;
  }

  .brand__logo--dark {
    display: none;
  }

  [data-theme="dark"] .brand__logo--light {
    display: none;
  }

  [data-theme="dark"] .brand__logo--dark {
    display: block;
  }

  /* The documentation itself stays readable whatever the theme of the components */
  .docs-title,
  .preview__title,
  .props-table__title {
    font-family: var(--docs-font);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .docs-kicker {
    font-family: var(--docs-font);
    font-weight: 700;
  }

  html[data-theme="plein-jour"] .docs-sidebar,
  html[data-theme="plein-jour"] .docs-main {
    background: var(--color-bg);
    border-color: var(--color-border);
  }

  html[data-theme="plein-jour"] body::before {
    content: none;
  }

  html[data-theme="plein-jour"] .docs-title {
    font-size: clamp(2rem, 2.4vw, 2.75rem);
    line-height: 1;
  }

  html[data-theme="plein-jour"] .preview__title {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  html[data-theme="plein-jour"] .preview {
    background: var(--color-bg);
  }

  body {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-fg);
    min-height: 100vh;
    position: relative;
    isolation: isolate;
  }

  /* Docs-specific look adjustments: remove rounded corners and heavy shadows */
  .docs-shell,
  .docs-sidebar,
  .docs-main,
  .card,
  .preview,
  .sidebar__link {
    --radius-sm: 0;
    --radius-md: 0;
    --radius-lg: 0;
    --color-shadow: transparent;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 14% 18%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 48%
      ),
      radial-gradient(
        circle at 82% 12%,
        color-mix(in srgb, var(--color-border) 35%, transparent),
        transparent 42%
      );
    pointer-events: none;
    z-index: -1;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    line-height: var(--line-tight);
    font-weight: normal;
  }

  p {
    margin: 0;
  }

  .docs-shell {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4);
    min-height: 100vh;
  }

  .docs-sidebar {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: var(--space-4);
    height: calc(100vh - var(--space-4) * 2);
    overflow: auto;
    box-shadow: none;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .brand__logo {
    width: min(190px, 100%);
  }

  .brand__logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand__title {
    font-family: var(--font-display);
    font-size: 1.75rem;
  }

  .brand__tag {
    text-transform: uppercase;
    font-size: var(--size-xs);
    letter-spacing: 0.22em;
    color: var(--color-muted);
  }

  .docs-main {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: clamp(1.5rem, 2vw, 2.5rem);
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .docs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  .docs-kicker {
    text-transform: uppercase;
    font-size: var(--size-xs);
    letter-spacing: 0.32em;
    color: var(--color-muted);
  }

  .docs-title {
    font-size: clamp(2rem, 2.4vw, 2.75rem);
    margin: var(--space-2) 0;
  }

  .docs-subtitle {
    color: var(--color-muted);
    font-size: var(--size-lg);
    max-width: 42ch;
  }

  .docs-content {
    display: grid;
    gap: var(--space-4);
  }

  @media (max-width: 960px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: static;
      height: auto;
    }
  }
</style>
