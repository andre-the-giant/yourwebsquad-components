---
import DocLayout from "../../../layouts/DocLayout.astro";
import Preview from "../../../components/Preview.astro";
import PropsTable from "../../../components/PropsTable.astro";
import { components } from "../../../data/components.js";
import Steps from "@lib/components/Steps/Steps.astro";

const examples: any[] = [
  {
    heading: "How we work",
    items: [
      {
        title: "Let's discuss your needs",
        text: "We explain your options and pick a plan."
      },
      {
        title: "We design and build",
        text: "You see progress every week."
      },
      {
        title: "Go live",
        text: "We connect your domain and run our checks."
      }
    ]
  }
];
const bodies = [""];
const codes = examples.map((p, i) =>
  bodies[i]
    ? `<Steps {...${JSON.stringify(p)}}>${bodies[i]}</Steps>`
    : `<Steps {...${JSON.stringify(p)}} />`
);

const props = [
  { name: "id", type: "string", description: "Optional id for the root element." },
  { name: "class", type: "string", description: "Additional class names." },
  { name: "style", type: "string", description: "Inline styles or CSS var overrides." },
  { name: "heading", type: "string", description: "Section title." },
  {
    name: "items",
    type: "{ title: string, text?: string }[]",
    default: "[]",
    description: "Steps, in order."
  },
  {
    name: "actions",
    type: '{ label: string, href?: string, variant?: "solid" | "outline" | "ghost" }[]',
    default: "[]",
    description: "Buttons below."
  },
  { name: "tone", type: '"default" | "surface"', default: '"default"', description: "Background." },
  { name: "flush", type: "boolean", default: "false", description: "No top padding." },
  {
    name: "items[].meta",
    type: "string",
    description: "Short line under the title, such as a duration."
  },
  {
    name: "layout",
    type: '"list" | "timeline"',
    default: '"list"',
    description: "timeline: markers joined by a line, across on large screens, down on phones."
  }
];
---

<DocLayout title="Steps" description="Ordered sequence with large numbers." items={components}>
  <PropsTable props={props} />
  <Preview title="Three steps" code={codes[0]}>
    <Steps {...examples[0]} />
  </Preview>
  <Preview
    title="Timeline with durations"
    code={'<Steps layout="timeline" items={[{ title: "Free visit", meta: "Within 48 h", text: "…" }, …]} />'}
  >
    <Steps
      flush
      layout="timeline"
      items={[
        { title: "Free visit", meta: "Within 48 h", text: "We walk the lot and check the soil." },
        { title: "Permit", meta: "2 to 4 weeks", text: "We file the septic permit." },
        { title: "Dig and install", meta: "3 to 5 days", text: "Tank, field bed, backfill." },
        { title: "Inspection", meta: "1 day", text: "The inspector signs off." },
        { title: "Grading", meta: "1 day", text: "Topsoil, seed, clean up." }
      ]}
    />
  </Preview>
</DocLayout>
