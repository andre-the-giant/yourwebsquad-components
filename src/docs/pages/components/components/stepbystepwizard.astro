---
import DocLayout from "@docs/layouts/DocLayout.astro";
import Preview from "@docs/components/Preview.astro";
import PropsTable from "@docs/components/PropsTable.astro";
import { components } from "@docs/data/components.js";
import StepByStepWizard from "@lib/components/StepByStepWizard/StepByStepWizard.astro";
import StepByStepSummary from "@lib/components/StepByStepSummary/StepByStepSummary.astro";
import StepByStepResult from "@lib/components/StepByStepResult/StepByStepResult.astro";
import List from "@lib/components/List/List.astro";

const wizardProps = [
  { name: "id", type: "string", description: "Root id; also the default storage key." },
  {
    name: "steps",
    type: "{ id, question, title?, help?, options: { value, label, description?, icon? }[] }[]",
    description: "Questions, one per screen. Options are radio tiles."
  },
  {
    name: "start",
    type: "{ eyebrow?, title, text?, bullets?: string[], button }",
    description: "Optional start screen."
  },
  {
    name: "labels",
    type: "object",
    description:
      "step, remaining, back, next, finish, error, errorHint, resume, resumeContinue, resumeRestart, calculating."
  },
  {
    name: "storageKey",
    type: "string",
    description: "Answers are kept in the browser under this key."
  },
  {
    name: "secondsPerStep",
    type: "number",
    default: "15",
    description: "For the remaining-time line."
  }
];

const summaryProps = [
  { name: "title", type: "string", default: '"Your answers"', description: "Title." },
  { name: "editLabel", type: "string", default: '"Change"', description: "Visible link text." },
  {
    name: "editTemplate",
    type: "string",
    default: '"Change: {title}"',
    description: "Accessible text."
  },
  {
    name: "pendingLabel",
    type: "string",
    default: '"In progress"',
    description: "Current question."
  },
  { name: "emptyLabel", type: "string", default: '"–"', description: "Questions not reached yet." },
  {
    name: "collapseBelow",
    type: "string",
    default: '"64rem"',
    description: "Folds under this width."
  },
  {
    name: "toggleTemplate",
    type: "string",
    default: '"Your answers ({count})"',
    description: "Toggle on phones."
  }
];

const resultProps = [
  {
    name: "variant",
    type: '"range" | "text"',
    default: '"range"',
    description: "Price range or text."
  },
  {
    name: "eyebrow",
    type: "string",
    default: '"Your estimate"',
    description: "Title of the screen."
  },
  {
    name: "pricing",
    type: "{ base: { min, max }, rules?: { [stepId]: { [value]: { factor?, add?, widen? } } }, round? }",
    description: "Range computation (variant range)."
  },
  {
    name: "duration",
    type: "{ base: { min, max }, rules? }",
    description: "Duration computation, shown with durationTemplate."
  },
  {
    name: "durationTemplate",
    type: "string",
    default: '"{min} to {max} weeks"',
    description: "Duration line."
  },
  { name: "currency", type: "string", default: '"CAD"', description: "ISO currency." },
  { name: "locale", type: "string", default: '"en-CA"', description: "fr-CA gives 22 000 $." },
  {
    name: "unsureValue",
    type: "string",
    default: '"unsure"',
    description: "Value meaning not sure yet."
  },
  {
    name: "wideAfter",
    type: "number",
    default: "2",
    description: "Unsure answers before the range widens."
  },
  { name: "wideNote", type: "string", description: "Shown when the range widens." },
  {
    name: "taxNote",
    type: "string",
    default: '"taxes extra"',
    description: "Next to the duration."
  },
  {
    name: "outcomeStep / outcomes",
    type: "string / { [value]: { title, text } }",
    description: "Text variant."
  }
];

const steps = [
  {
    id: "room",
    title: "Room",
    question: "Which room?",
    options: [
      { value: "main", label: "Main bathroom" },
      { value: "ensuite", label: "Ensuite" },
      { value: "powder", label: "Powder room" },
      { value: "basement", label: "Basement" }
    ]
  },
  {
    id: "size",
    title: "Size",
    question: "How big is it?",
    options: [
      { value: "small", label: "Small", description: "Under 40 sq ft" },
      { value: "medium", label: "Medium", description: "40 to 70 sq ft" },
      { value: "large", label: "Large", description: "Over 70 sq ft" },
      { value: "unsure", label: "Not sure", description: "We measure at the visit" }
    ]
  },
  {
    id: "finish",
    title: "Finish",
    question: "Which level of finish do you picture?",
    help: "It helps us pick the materials of the estimate. You can change everything at the design stage.",
    options: [
      {
        value: "essential",
        label: "Essential",
        description: "Ceramic, chrome fixtures, stock vanity."
      },
      {
        value: "comfort",
        label: "Comfort",
        description: "Large porcelain, glass shower, custom vanity."
      },
      { value: "premium", label: "Premium", description: "Marble, heated floor, custom niche." },
      {
        value: "unsure",
        label: "Not sure yet",
        description: "We will show you samples at the visit."
      }
    ]
  }
];

const pricing = {
  base: { min: 18000, max: 24000 },
  rules: {
    room: { powder: { factor: 0.55 }, basement: { factor: 0.9 } },
    size: { small: { factor: 0.85 }, large: { factor: 1.25 } },
    finish: { essential: { factor: 0.8 }, premium: { factor: 1.45 } }
  },
  round: 500
};

const duration = {
  base: { min: 3, max: 4 },
  rules: { size: { large: { add: 1 } }, finish: { premium: { add: 1 } } }
};

const code = `<StepByStepWizard id="quote" steps={steps} start={{ title: "How much would your bathroom cost?", button: "Start" }}
  labels={{ finish: "See my estimate" }}>
  <StepByStepSummary slot="aside" />
  <StepByStepResult slot="result" pricing={pricing} duration={duration}>
    <p>Indicative price…</p>
  </StepByStepResult>
  <form>… <input type="hidden" name="answers" data-stepbystep-answers /> …</form>
</StepByStepWizard>`;
const branchCode = `<StepByStepWizard id="request" prefill steps={[
  { id: "service", question: "What can we do for you?", options: [{ value: "rental", label: "Rent a machine" }, { value: "works", label: "Get work done" }] },
  { id: "machine", question: "Which machine?", when: { step: "service", is: "rental" }, options: [{ value: "mini-35", label: "Mini excavator 3.5 t", group: "Excavators" }, …] },
  { id: "duration", question: "When and for how long?", when: { step: "service", is: "rental" }, options: […], fields: [{ name: "start", label: "Start date", type: "date", min: "today", required: true }] },
  { id: "delivery", question: "How does it get to you?", when: …, options: […], fields: [{ name: "postal", label: "Site postal code", when: "truck", required: true }] },
  { id: "extras", question: "Options", type: "checkbox", optional: true, when: …, options: [{ value: "breaker", label: "Hydraulic breaker" }, { value: "none", label: "None", exclusive: true }] },
  { id: "works", question: "What work?", when: { step: "service", is: "works" }, options: […] },
  { id: "photos", question: "Photos of the lot?", type: "upload", optional: true, form: "contact", when: … }
]}>
  <StepByStepResult slot="result" variant="total" when={{ step: "service", is: "rental" }} total={{ lines: [
    { label: "{label:machine}, {label:duration}", table: { step: "machine", values: { "mini-35": { day: 329, week: 1290 } }, column: { step: "duration", map: { "1d": "day", "1w": "week" } } } },
    { label: "Delivery, 2 trips", when: { step: "delivery", is: "truck" }, amount: 145, quantity: 2 },
    { label: "Damage protection 12 %", when: { step: "extras", is: "protection" }, percent: 12 }
  ] }} />
  <StepByStepResult slot="result" when={{ step: "service", is: "works" }} pricing={{ base: { min: 5000, max: 9000 }, ranges: [{ step: "works", values: { septic: { min: 18000, max: 28000 } } }] }} />
</StepByStepWizard>`;
---

<DocLayout
  title="StepByStepWizard"
  description="One question at a time, a progress bar, a summary of the answers and a result. Generic: a quote here, a quiz elsewhere."
  items={components}
>
  <PropsTable title="StepByStepWizard" props={wizardProps} />
  <PropsTable title="StepByStepSummary" props={summaryProps} />
  <PropsTable title="StepByStepResult" props={resultProps} />

  <Preview title="Quote with summary and price range" code={code}>
    <StepByStepWizard
      id="quote-demo"
      steps={steps}
      start={{
        eyebrow: "Free estimate",
        title: "How much would your bathroom cost?",
        text: "Three questions, a price range right away, no email needed.",
        bullets: ["One question at a time", "Go back at any time, answers kept"],
        button: "Start"
      }}
      labels={{
        finish: "See my estimate",
        errorHint: "Not sure? “Not sure yet” is a fine answer."
      }}
    >
      <StepByStepSummary slot="aside" />
      <StepByStepResult slot="result" pricing={pricing} duration={duration}>
        <p>
          <b>Indicative price.</b> It varies with the materials, the exact size and the state of the room.
          The price is fixed once the design is approved.
        </p>
        <List
          items={[
            "Design, plans and city permit",
            "Demolition, plumbing, electrical",
            "5-year warranty on labour"
          ]}
        />
      </StepByStepResult>
      <input type="hidden" name="answers" data-stepbystep-answers />
      <input type="hidden" name="range" data-stepbystep-result />
    </StepByStepWizard>
  </Preview>
  <Preview title="Several paths, more question types, line-by-line total" code={branchCode}>
    <StepByStepWizard
      id="request-demo"
      storageKey="docs-request-demo"
      prefill
      steps={[
        {
          id: "service",
          question: "What can we do for you?",
          title: "Service",
          options: [
            { value: "rental", label: "Rent a machine", description: "You drive, we deliver." },
            {
              value: "works",
              label: "Get work done",
              description: "We come with the machine and the operator."
            }
          ]
        },
        {
          id: "machine",
          question: "Which machine?",
          title: "Machine",
          when: { step: "service", is: "rental" },
          options: [
            {
              value: "mini-18",
              label: "Mini excavator 1.8 t",
              description: "$249/day",
              group: "Excavators"
            },
            {
              value: "mini-35",
              label: "Mini excavator 3.5 t",
              description: "$329/day",
              group: "Excavators"
            },
            {
              value: "skid-28",
              label: "Skid steer 2.8 t",
              description: "$389/day",
              group: "Loaders"
            },
            { value: "unsure", label: "Not sure, advise me", group: "Other" }
          ],
          fields: [
            {
              name: "job",
              label: "Describe the job",
              type: "textarea",
              when: "unsure",
              required: true
            }
          ]
        },
        {
          id: "duration",
          question: "When and for how long?",
          title: "Duration",
          when: { step: "service", is: "rental" },
          options: [
            { value: "1d", label: "1 day" },
            { value: "3d", label: "2 or 3 days" },
            { value: "1w", label: "1 week" }
          ],
          fields: [
            { name: "start", label: "Start date", type: "date", min: "today", required: true }
          ]
        },
        {
          id: "delivery",
          question: "How does the machine get to you?",
          title: "Delivery",
          when: { step: "service", is: "rental" },
          help: "Your vehicle must tow 3,500 kg for a 3.5 t mini excavator.",
          options: [
            { value: "truck", label: "Delivery by float truck" },
            { value: "pickup", label: "I pick it up with my trailer" }
          ],
          fields: [
            {
              name: "postal",
              label: "Site postal code",
              when: "truck",
              required: true,
              autocomplete: "postal-code",
              pattern: "[A-Za-z]\\d[A-Za-z] ?\\d[A-Za-z]\\d",
              error: "Enter a postal code, such as K8N 4Z5."
            }
          ]
        },
        {
          id: "extras",
          question: "Options",
          type: "checkbox",
          optional: true,
          when: { step: "service", is: "rental" },
          options: [
            { value: "breaker", label: "Hydraulic breaker ($95/day)" },
            { value: "protection", label: "Damage protection (12 %)" },
            { value: "none", label: "None", exclusive: true }
          ]
        },
        {
          id: "works",
          question: "What work?",
          title: "Work",
          when: { step: "service", is: "works" },
          options: [
            { value: "septic", label: "Septic system" },
            { value: "driveway", label: "Driveway" },
            { value: "other", label: "Something else" }
          ],
          fields: [{ name: "other", label: "Tell us more", when: "other", required: true }]
        },
        {
          id: "photos",
          question: "Photos of the lot?",
          title: "Photos",
          type: "upload",
          optional: true,
          maxFiles: 5,
          when: { step: "service", is: "works" },
          help: "One wide shot and one of the access for the machine help a lot."
        }
      ]}
    >
      <StepByStepSummary slot="aside" />
      <StepByStepResult
        slot="result"
        variant="total"
        when={{ step: "service", is: "rental" }}
        eyebrow="Your estimate"
        taxNote="taxes extra"
        total={{
          lines: [
            {
              label: "{label:machine}, {label:duration}",
              table: {
                step: "machine",
                values: {
                  "mini-18": { day: 249, week: 990 },
                  "mini-35": { day: 329, week: 1290 },
                  "skid-28": { day: 389, week: 1590 }
                },
                column: { step: "duration", map: { "1d": "day", "3d": "day", "1w": "week" } }
              },
              quantity: { step: "duration", map: { "1d": 1, "3d": 3, "1w": 1 } }
            },
            {
              label: "Delivery, 2 trips",
              when: { step: "delivery", is: "truck" },
              amount: 145,
              quantity: 2
            },
            {
              label: "Hydraulic breaker",
              when: { step: "extras", is: "breaker" },
              amount: 95,
              quantity: { step: "duration", map: { "1d": 1, "3d": 3, "1w": 5 } }
            },
            {
              label: "Damage protection 12 %",
              when: { step: "extras", is: "protection" },
              percent: 12
            }
          ],
          fallback: "We call you back with a price."
        }}
      />
      <StepByStepResult
        slot="result"
        when={{ step: "service", is: "works" }}
        pricing={{
          base: { min: 4000, max: 9000 },
          ranges: [
            {
              step: "works",
              values: { septic: { min: 18000, max: 28000 }, driveway: { min: 4500, max: 12000 } }
            }
          ]
        }}
      />
    </StepByStepWizard>
  </Preview>
</DocLayout>
