---
import DocLayout from "@docs/layouts/DocLayout.astro";
import Preview from "@docs/components/Preview.astro";
import PropsTable from "@docs/components/PropsTable.astro";
import { components } from "@docs/data/components.js";
import Lightbox from "@lib/components/Lightbox/Lightbox.astro";

const props = [
  { name: "id", type: "string", description: "Referenced by triggers (data-lightbox-open)." },
  { name: "images", type: "{ src, alt, caption? }[]", description: "Photos." },
  { name: "label", type: "string", default: '"Photos"', description: "Accessible name." },
  { name: "closeLabel", type: "string", default: '"Close"', description: "Close button." },
  {
    name: "prevLabel",
    type: "string",
    default: '"Previous photo"',
    description: "Previous button."
  },
  { name: "nextLabel", type: "string", default: '"Next photo"', description: "Next button." },
  {
    name: "counterTemplate",
    type: "string",
    default: '"{index} / {total}"',
    description: "Counter."
  },
  {
    name: "groups",
    type: "{ images, panel?: { title, text?, facts?, quote?, author?, link? } }[]",
    description: "Several series, each with a text panel beside the photos."
  }
];
---

<DocLayout
  title={"Lightbox"}
  description={'Full-screen photo viewer built on Modal (size="full"). Arrows, counter, caption, swipe; left/right keys, Escape closes, focus returns to the photo.'}
  items={components}
>
  <PropsTable props={props} />
  <Preview
    title={"Preview"}
    code={'<a href="full.jpg" data-lightbox-open="gallery" data-lightbox-index="0"><img src="thumb.jpg" alt="…" /></a>\n<Lightbox id="gallery" images={[…]} />'}
  >
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;max-width:36rem">
      {
        [1, 2, 3].map((n, i) => (
          <a
            href={`https://picsum.photos/seed/lb${n}/1600/1100`}
            data-lightbox-open="lightbox-demo"
            data-lightbox-index={i}
          >
            <img
              src={`https://picsum.photos/seed/lb${n}/400/300`}
              alt={`Renovated bathroom, view ${n}`}
              style="display:block;width:100%"
            />
          </a>
        ))
      }
    </div>
    <Lightbox
      id="lightbox-demo"
      images={[1, 2, 3].map((n) => ({
        src: `https://picsum.photos/seed/lb${n}/1600/1100`,
        alt: `Renovated bathroom, view ${n}`,
        caption: `Detail ${n}`
      }))}
    />
  </Preview>
  <Preview
    title="Series with a panel (a whole project each)"
    code={'<Lightbox id="projects" groups={[{ images: […], panel: { title: "Septic system, Ameliasburgh", facts: [{ label: "Duration", value: "4 days" }] } }, …]} />\n<a href="…" data-lightbox-open="projects" data-lightbox-group="1">…</a>'}
  >
    <div style="display:flex;flex-wrap:wrap;gap:1rem">
      <a
        href="https://picsum.photos/seed/lbg1/1600/1000"
        data-lightbox-open="lightbox-groups"
        data-lightbox-group="0"
        data-lightbox-index="0"
      >
        <img
          src="https://picsum.photos/seed/lbg1/320/200"
          alt="Septic system, Ameliasburgh: open the photos"
          width="160"
          height="100"
        />
      </a>
      <a
        href="https://picsum.photos/seed/lbg3/1600/1000"
        data-lightbox-open="lightbox-groups"
        data-lightbox-group="1"
        data-lightbox-index="0"
      >
        <img
          src="https://picsum.photos/seed/lbg3/320/200"
          alt="Gravel driveway, Stirling: open the photos"
          width="160"
          height="100"
        />
      </a>
    </div>
    <Lightbox
      id="lightbox-groups"
      label="Projects"
      groups={[
        {
          images: [
            {
              src: "https://picsum.photos/seed/lbg1/1600/1000",
              alt: "Open trench for the septic tank"
            },
            { src: "https://picsum.photos/seed/lbg2/1600/1000", alt: "Finished field bed, seeded" }
          ],
          panel: {
            title: "Septic system, Ameliasburgh",
            text: "Raised bed on clay, two steps from the bay.",
            facts: [
              { label: "Duration", value: "4 days" },
              { label: "Price", value: "about $31,000" }
            ],
            quote: "They left the lawn cleaner than they found it.",
            author: "Martine L."
          }
        },
        {
          images: [
            {
              src: "https://picsum.photos/seed/lbg3/1600/1000",
              alt: "New gravel driveway with a culvert"
            }
          ],
          panel: { title: "Gravel driveway, Stirling", facts: [{ label: "Length", value: "80 m" }] }
        }
      ]}
    />
  </Preview>
</DocLayout>
