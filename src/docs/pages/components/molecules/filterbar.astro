---
import DocLayout from "@docs/layouts/DocLayout.astro";
import Preview from "@docs/components/Preview.astro";
import PropsTable from "@docs/components/PropsTable.astro";
import { components } from "@docs/data/components.js";
import FilterBar from "@lib/components/FilterBar/FilterBar.astro";
import Card from "@lib/components/Card/Card.astro";
import CardGrid from "@lib/components/CardGrid/CardGrid.astro";

const props = [
  {
    name: "target",
    type: "string",
    description: "Id of the list to filter, or of a block that holds it, such as a CardGrid."
  },
  { name: "filters", type: "{ label, value }[]", description: "Filters." },
  { name: "allLabel", type: "string", default: '"All"', description: "First filter." },
  { name: "multiple", type: "boolean", default: "false", description: "Several filters at once." },
  {
    name: "showCounts",
    type: "boolean",
    default: "true",
    description: "Item count on each filter."
  },
  { name: "param", type: "string", default: '"type"', description: "URL parameter." },
  {
    name: "sort",
    type: "{ label, options: { label, value, key, order? }[] }",
    description: "Optional sort select; key names data-sort-<key> on items."
  },
  {
    name: "countTemplate",
    type: "string",
    default: '"{count} items"',
    description: "Announced count."
  },
  {
    name: "emptyText",
    type: "string",
    default: '"Nothing for this filter yet."',
    description: "Empty state."
  },
  { name: "resetLabel", type: "string", default: '"Show all"', description: "Reset button." },
  {
    name: "label",
    type: "string",
    default: '"Filter by type"',
    description: "Accessible name of the group."
  },
  {
    name: "groups",
    type: "{ label, param, filters, allLabel?, multiple? }[]",
    description: "Several groups combined (category AND weight), each with its URL parameter."
  },
  {
    name: "panel",
    type: "boolean",
    default: "groups > 1",
    description: "Below 48rem, the groups and the sort move into a full-screen panel."
  },
  {
    name: "panelLabel / applyTemplate / closeLabel",
    type: "string",
    default: '"Filters" / "Show {count} items" / "Close the filters"',
    description: "Panel button and title, closing button, close icon name."
  }
];
---

<DocLayout
  title={"FilterBar"}
  description={"Toggle filters for any list on the page. Items carry data-tags. The filter is kept in the URL; without JS the filters are links and the list stays whole."}
  items={components}
>
  <PropsTable props={props} />
  <Preview
    title={"With Card items"}
    code={'<FilterBar target="filter-demo" filters={[{ label: "Walk-in shower", value: "shower" }, …]} />\n<ul id="filter-demo"><Card as="li" tags={["shower"]} … /></ul>'}
  >
    <FilterBar
      target="filter-demo"
      filters={[
        { label: "Walk-in shower", value: "shower" },
        { label: "Bathtub", value: "tub" },
        { label: "Heritage home", value: "heritage" }
      ]}
      countTemplate="{count} projects"
    />
    <ul
      id="filter-demo"
      style="display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1.5rem;list-style:none;padding:0;margin:1.5rem 0 0"
    >
      <Card
        as="li"
        title="King Street West"
        tag="Walk-in shower"
        meta="5 weeks"
        href="#"
        img="https://picsum.photos/seed/f1/800/600"
        alt="Marble shower"
        tags={["shower", "heritage"]}
      />
      <Card
        as="li"
        title="Portsmouth"
        tag="Bathtub"
        meta="5 weeks"
        href="#"
        img="https://picsum.photos/seed/f2/800/600"
        alt="Bathtub"
        tags={["tub"]}
      />
      <Card
        as="li"
        title="Sydenham"
        tag="Heritage home"
        meta="4 weeks"
        href="#"
        img="https://picsum.photos/seed/f3/800/600"
        alt="Period bathroom"
        tags={["heritage"]}
      />
    </ul>
  </Preview>
  <Preview
    title={"With a CardGrid and a sort"}
    code={'<FilterBar target="grid-demo" filters={[…]} sort={{ label: "Sort", options: [{ label: "Budget, low to high", value: "asc", key: "budget" }, …] }} />\n<CardGrid id="grid-demo" items={[{ …, tags: ["tub"], sort: { budget: 38000 } }]} />'}
  >
    <FilterBar
      id="grid-filter"
      target="grid-demo"
      param="kind"
      filters={[
        { label: "Walk-in shower", value: "shower" },
        { label: "Bathtub", value: "tub" }
      ]}
      sort={{
        label: "Sort",
        options: [
          { label: "Budget, low to high", value: "asc", key: "budget", order: "asc" },
          { label: "Budget, high to low", value: "desc", key: "budget", order: "desc" }
        ]
      }}
      countTemplate="{count} projects"
    />
    <CardGrid
      id="grid-demo"
      columns={3}
      items={[
        {
          title: "Portsmouth",
          href: "#",
          img: "https://picsum.photos/seed/g1/800/600",
          alt: "Bathtub",
          meta: "$38,000",
          tags: ["tub"],
          sort: { budget: 38000 }
        },
        {
          title: "Bath",
          href: "#",
          img: "https://picsum.photos/seed/g2/800/600",
          alt: "Walk-in shower",
          meta: "$27,000",
          tags: ["shower"],
          sort: { budget: 27000 }
        },
        {
          title: "Williamsville",
          href: "#",
          img: "https://picsum.photos/seed/g3/800/600",
          alt: "Glass shower",
          meta: "$19,000",
          tags: ["shower"],
          sort: { budget: 19000 }
        }
      ]}
      style="--band-gutter: 0px; --band-padding: 1.5rem"
    />
  </Preview>
  <Preview
    title="Two groups, panel on phones"
    code={'<FilterBar target="fleet" groups={[{ label: "Category", param: "cat", filters: […] }, { label: "Weight", param: "weight", filters: […] }]} sort={…} />'}
  >
    <div style="display:grid;gap:1.25rem">
      <FilterBar
        target="fleet-demo"
        countTemplate="{count} machines"
        applyTemplate="Show {count} machines"
        emptyText="No machine matches. Try another weight."
        resetLabel="Clear the filters"
        groups={[
          {
            label: "Category",
            param: "cat",
            filters: [
              { label: "Excavators", value: "excavator" },
              { label: "Loaders", value: "loader" }
            ]
          },
          {
            label: "Weight",
            param: "weight",
            filters: [
              { label: "Under 4 t", value: "light" },
              { label: "4 t and more", value: "heavy" }
            ]
          }
        ]}
        sort={{
          label: "Sort",
          options: [
            { label: "Price, low to high", value: "price-asc", key: "price" },
            { label: "Price, high to low", value: "price-desc", key: "price", order: "desc" }
          ]
        }}
      />
      <CardGrid
        id="fleet-demo"
        flush
        items={[
          {
            title: "Mini excavator 1.8 t",
            text: "Day $249",
            tags: ["excavator", "light"],
            sort: { price: 249 }
          },
          {
            title: "Mini excavator 3.5 t",
            text: "Day $329",
            tags: ["excavator", "light"],
            sort: { price: 329 }
          },
          {
            title: "Excavator 8 t",
            text: "Day $590",
            tags: ["excavator", "heavy"],
            sort: { price: 590 }
          },
          {
            title: "Skid steer 2.8 t",
            text: "Day $389",
            tags: ["loader", "light"],
            sort: { price: 389 }
          },
          {
            title: "Wheel loader 9 t",
            text: "Day $690",
            tags: ["loader", "heavy"],
            sort: { price: 690 }
          }
        ]}
      />
    </div>
  </Preview>
</DocLayout>
