---
import DocLayout from "../../layouts/DocLayout.astro";
import Preview from "../../components/Preview.astro";
import PropsTable from "../../components/PropsTable.astro";
import { components } from "../../data/components.js";
import PageHero from "@lib/components/PageHero/PageHero.astro";
import GoogleRating from "@lib/components/GoogleRating/GoogleRating.astro";

const examples: any[] = [
  {
    title: "Website pricing",
    lead: "A complete online presence for one monthly price.",
    breadcrumb: [
      {
        label: "Home",
        href: "/"
      },
      {
        label: "Pricing"
      }
    ]
  }
];
const bodies = [""];
const codes = examples.map((p, i) =>
  bodies[i]
    ? `<PageHero {...${JSON.stringify(p)}}>${bodies[i]}</PageHero>`
    : `<PageHero {...${JSON.stringify(p)}} />`
);

const props = [
  { name: "id", type: "string", description: "Optional id for the root element." },
  { name: "class", type: "string", description: "Additional class names." },
  { name: "style", type: "string", description: "Inline styles or CSS var overrides." },
  {
    name: "eyebrow",
    type: "string",
    description: "Short line above the title, such as the trade and the city."
  },
  { name: "title", type: "string", description: "Required. The page's only h1." },
  { name: "accent", type: "string", description: "Part of the title to highlight." },
  { name: "lead", type: "string", description: "Text under the title." },
  { name: "note", type: "string", description: "Small text, such as a price or an update date." },
  { name: "slogan", type: "string", description: "Full layout only, below the image." },
  {
    name: "actions",
    type: '{ label: string, href?: string, variant?: "solid" | "outline" | "ghost" }[]',
    default: "[]",
    description: "2 at most."
  },
  {
    name: "breadcrumb",
    type: "{ label: string, href?: string }[]",
    default: "[]",
    description: "Trail above the title."
  },
  { name: "breadcrumbLabel", type: "string", description: "Accessible name of the trail." },
  { name: "img", type: "string", description: "Image source." },
  {
    name: "alt",
    type: "string",
    default: '""',
    description: "Image description. Empty for a decorative image."
  },
  {
    name: "layout",
    type: '"text" | "split" | "full"',
    default: '"text"',
    description: "Text only, image on the right, or full-width image below."
  },
  {
    name: "shader",
    type: '"waves" | "smoke-ring" | "god-rays" | "neuro-noise"',
    default: "—",
    description:
      "Animated WebGL background (see ShaderBackground). Behind the text block, flipped so the dark end is under the title. Text turns light."
  },
  {
    name: "shaderColors",
    type: "string[]",
    default: "the preset's colours",
    description: "2 to 8 hex colours, low → high. The first is the dark base the text sits on."
  },
  {
    name: "animate",
    type: "boolean",
    default: "true",
    description:
      "Shader motion. false, or reduced motion, draws one still frame. Paused when the tab is hidden or off screen."
  },
  {
    name: "slot meta",
    type: "slot",
    description: "Under the buttons: price chips, a rating badge, short facts."
  },
  {
    name: "--type-heading-transform",
    type: "CSS variable",
    default: "none",
    description: "Case of the title (uppercase in some themes)."
  },
  {
    name: "--pagehero-accent-bg / --pagehero-accent-fg / --pagehero-accent-padding",
    type: "CSS variables",
    description: "Highlight of the accent words."
  },
  {
    name: "--pagehero-accent-inverse-fg / --pagehero-accent-inverse-bg",
    type: "CSS variables",
    description: "Highlight of the accent words on a shader (default: the shader's light colour)."
  },
  {
    name: "--pagehero-eyebrow-inverse-color",
    type: "CSS variable",
    default: "rgb(255 255 255 / 0.85)",
    description: "Eyebrow colour on a shader."
  }
];
const shaderCode = `<PageHero
  layout="split"
  shader="waves"
  eyebrow="Pool care · Ottawa"
  title="Clear water all summer"
  accent="all summer"
  lead="Opening, weekly visits and closing by one technician."
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Pool care" }]}
  actions={[{ label: "Get my season price", href: "#" }, { label: "See the plans", href: "#", variant: "outline" }]}
  img="https://picsum.photos/900/1100"
  alt=""
/>`;
const metaCode = `<PageHero eyebrow="Bathroom renovation in Kingston" title="A bathroom that breathes" lead="Walk-in showers, marble, light." actions={[{ label: "Estimate my project" }, { label: "613 555-0142", href: "tel:+16135550142", variant: "ghost" }]}>
  <GoogleRating slot="meta" rating={4.9} count={127} variant="inline" />
</PageHero>`;
---

<DocLayout
  title="PageHero"
  description="Top of a page with its only h1. Hero stays the centered banner."
  items={components}
>
  <PropsTable props={props} />
  <Preview title="Text" code={codes[0]}>
    <PageHero {...examples[0]} />
  </Preview>
  <Preview title="Eyebrow and meta slot" code={metaCode}>
    <PageHero
      eyebrow="Bathroom renovation in Kingston"
      title="A bathroom that breathes"
      lead="Walk-in showers, marble, light."
      actions={[
        { label: "Estimate my project", href: "#" },
        { label: "613 555-0142", href: "tel:+16135550142", variant: "ghost" }
      ]}
    >
      <GoogleRating slot="meta" rating={4.9} count={127} variant="inline" />
    </PageHero>
  </Preview>
  <Preview title="Shader background" code={shaderCode}>
    <PageHero
      layout="split"
      shader="waves"
      eyebrow="Pool care · Ottawa"
      title="Clear water all summer"
      accent="all summer"
      lead="Opening, weekly visits and closing by one technician."
      breadcrumb={[{ label: "Home", href: "/" }, { label: "Pool care" }]}
      actions={[
        { label: "Get my season price", href: "#" },
        { label: "See the plans", href: "#", variant: "outline" }
      ]}
      img="https://picsum.photos/900/1100"
      alt=""
    />
  </Preview>
  <Preview
    title="Highlighted words (theme variables)"
    code={'<PageHero title="Big machines. Small hassles." accent="Small hassles." style="--pagehero-accent-bg: linear-gradient(transparent 0 14%, #ffc20e 14% 94%, transparent 94%); --pagehero-accent-fg: #17150f; --pagehero-accent-padding: 0 0.12em; --type-heading-transform: uppercase" … />'}
  >
    <PageHero
      eyebrow="Excavation · Belleville"
      title="Big machines. Small hassles."
      accent="Small hassles."
      lead="Equipment rental and earthwork, from the founding hole to the last load of gravel."
      actions={[{ label: "Rent a machine", href: "#" }]}
      style="--pagehero-accent-bg:linear-gradient(transparent 0 14%, #ffc20e 14% 94%, transparent 94%);--pagehero-accent-fg:#17150f;--pagehero-accent-padding:0 0.12em;--type-heading-transform:uppercase"
    />
  </Preview>
</DocLayout>
