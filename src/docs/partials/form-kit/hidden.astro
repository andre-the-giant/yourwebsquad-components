---
import Preview from "@docs/components/Preview.astro";
import PropsTable from "@docs/components/PropsTable.astro";
import FormHidden from "@lib/components/Form-Hidden/Form-Hidden.astro";

const basicCode = `<form>
  <FormHidden name="token" value="abc123" />
  <p>Hidden value ready to submit.</p>
</form>`;

const props = [
  { name: "id", type: "string", description: "Optional id for the hidden input." },
  { name: "name", type: "string", description: "Field name to submit." },
  { name: "value", type: "string", default: '""', description: "Value to submit." }
];
---

<PropsTable props={props} />

<Preview title="Usage" code={basicCode}>
  <form class="demo-form">
    <FormHidden name="token" value="abc123" />
    <p>Hidden value ready to submit.</p>
  </form>
</Preview>

<style>
  .demo-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
